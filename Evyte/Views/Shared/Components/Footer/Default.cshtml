@using Microsoft.AspNetCore.Localization
@model GeneralInformation
@{
    var language = ViewBag.CurrentLanguage as string ?? Context.Request.Cookies[CookieRequestCultureProvider.DefaultCookieName]?.Split('|')[0]?.Split('=')[1] ?? "ar";
    var isArabic = language == "ar";
}

<!-- start of wpo-site-footer-section -->
<footer class="wpo-site-footer-s2">
    <div class="wpo-upper-footer">
        <div class="container">
            <div class="row align-items-center">
                <div class="col col-xl-3 col-lg-4 col-md-6 col-sm-12 col-12">
                    <div class="widget link-widget">
                        <div class="widget-title">
                            <h3>@(isArabic ? "روابط سريعة" : "Links")</h3>
                        </div>
                        <div class="link-wrap">
                            <ul>
                                <li><a asp-controller="Home" asp-action="About">@(isArabic ? "من نحن" : "About")</a></li>
                                <li><a asp-controller="Home" asp-action="Designs">@(isArabic ? "التصاميم" : "Designs")</a></li>
                            </ul>
                            <ul>
                                <li><a asp-controller="Home" asp-action="FAQs">@(isArabic ? "الأسئلة الشائعة" : "FAQs")</a></li>
                                <li><a asp-controller="Home" asp-action="Contact">@(isArabic ? "اتصل بنا" : "Contact")</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col col-xl-6 col-lg-4 col-md-6 col-sm-12 col-12">
                    <div class="widget about-widget">
                        <div class="logo widget-title">
                            <a class="logo" href="index.html">Eventa</a>
                        </div>
                        <p>
                            @(isArabic ? "لا يمكننا الانتظار لرؤية جميع أصدقائنا وأقاربنا الأعزاء في حفل زفافنا." :
                                "We can’t wait to see all of our beloved friends and relatives at our wedding.")
                        </p>
                        <ul>
                            @if (!string.IsNullOrWhiteSpace(Model.FaceBook))
                            {
                                <li>
                                    <a target="_blank" href="@Model.FaceBook">
                                        <i class="ti-facebook"></i>
                                    </a>   
                                    </li>
                            } @if (!string.IsNullOrWhiteSpace(Model.X))
                            {
                                <li>
                                    <a target="_blank" href="@Model.X">
                                        <i class="ti-twitter-alt"></i>
                                    </a>
                                </li>
                            } @if (!string.IsNullOrWhiteSpace(Model.Instagram))
                            {
                                <li>
                                        <a target="_blank" href="@Model.Instagram">
                                        <i class="ti-instagram"></i>
                                    </a>
                                </li>
                            } @if (!string.IsNullOrWhiteSpace(Model.Tiktok))
                            {
                                <li>
                                    <a target="_blank" href="@Model.Tiktok">
                                        <i class="fa fa-tiktok"></i>
                                    </a>
                                </li>
                            } @if (!string.IsNullOrWhiteSpace(Model.Snapchat))
                            {
                                <li>
                                    <a target="_blank" href="@Model.Snapchat">
                                        <i class="fa fa-snapchat"></i>
                                    </a>
                                </li>
                            } @if (!string.IsNullOrWhiteSpace(Model.Youtube))
                            {
                                <li>
                                    <a target="_blank" href="@Model.Youtube">
                                        <i class="ti-youtube"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="col col-xl-3 col-lg-4 col-md-6 col-sm-12 col-12">
                    <div class="widget wpo-service-link-widget">
                        <div class="widget-title">
                            <h3>@(isArabic ? "تواصل معنا" : "Contact")</h3>
                        </div>
                        <div class="contact-ft">
                            <p>@Model.Email</p>
                            @if (!string.IsNullOrWhiteSpace(Model.Email2))
                            {
                                <p>@Model.Email2</p>
                            }
                            <p>
                                @(isArabic ? Model.AddressAr : Model.AddressEn)
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="wpo-lower-footer">
        <div class="container">
            <div class="row">
                <div class="col col-xs-12">
                    <p class="copyright">
                        &copy; @(isArabic ? "حقوق النشر" : "Copyright") 2025 | <a href="index.html">Eventa</a> |
                        @(isArabic ? "جميع الحقوق محفوظة" : "All right reserved")
                    </p>
                </div>
            </div>
        </div>
    </div>
    <!-- بقية الفوتر كما هو -->
</footer>