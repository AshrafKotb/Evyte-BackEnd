@using Microsoft.AspNetCore.Localization
@model GeneralInformation
@{
    // استخدم الـ culture الحالية من الـ request localization
    var culture = System.Globalization.CultureInfo.CurrentCulture.Name;
    var isArabic = culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    string link = "https://wa.me/2" + Model.WhatsApp;
}

<!-- Floating Action Buttons - WhatsApp, Messenger, Create Invitation -->
<div class="floating-actions">
    <!-- Create Invitation Button -->
    <a href="@Url.Action("CreateNew", "Invitations")"
       class="floating-btn create-btn"
       title="@(isArabic ? "إنشاء دعوة" : "Create Invitation")">
        <i class="fas fa-plus"></i>
        <span class="floating-tooltip">@(isArabic ? "إنشاء دعوة" : "Create Invitation")</span>
    </a>

    <!-- WhatsApp Icon -->
    <a href="@link"
       target="_blank"
       class="floating-btn whatsapp-btn"
       title="@(isArabic ? "تواصل معنا على واتساب" : "Contact us on WhatsApp")">
        <i class="fab fa-whatsapp"></i>
        <span class="floating-tooltip">@(isArabic ? "واتساب" : "WhatsApp")</span>
    </a>

    <!-- Messenger Icon -->
    <a href="https://m.me/eventa.invitation"
       target="_blank"
       class="floating-btn messenger-btn"
       title="@(isArabic ? "تواصل معنا على ماسنجر" : "Contact us on Messenger")">
        <i class="fab fa-facebook-messenger"></i>
        <span class="floating-tooltip">@(isArabic ? "ماسنجر" : "Messenger")</span>
    </a>
</div>

<style>
    /* Floating Action Buttons */
    .floating-actions {
        position: fixed;
        bottom: 30px;
        left: 30px;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .floating-btn {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.4rem;
        text-decoration: none;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

    .floating-btn:hover {
        transform: scale(1.1) translateY(-3px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
        color: white;
    }

    .floating-btn i {
        transition: transform 0.3s ease;
    }

    .floating-btn:hover i {
        transform: rotate(90deg);
    }

    .whatsapp-btn:hover i,
    .messenger-btn:hover i {
        transform: scale(1.1);
    }

    .create-btn {
        background: linear-gradient(135deg, #C5A55A 0%, #D4BA7A 100%);
    }

    .create-btn:hover {
        background: linear-gradient(135deg, #A8893E 0%, #B8963E 100%);
    }

    .whatsapp-btn {
        background: #25D366;
    }

    .whatsapp-btn:hover {
        background: #128C7E;
    }

    .messenger-btn {
        background: linear-gradient(135deg, #00B2FF 0%, #006AFF 100%);
    }

    .messenger-btn:hover {
        background: linear-gradient(135deg, #0099E6 0%, #0052CC 100%);
    }

    /* Tooltip */
    .floating-tooltip {
        position: absolute;
        left: calc(100% + 12px);
        background: rgba(31, 41, 55, 0.95);
        color: white;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 500;
        white-space: nowrap;
        opacity: 0;
        visibility: hidden;
        transform: translateX(-10px);
        transition: all 0.3s ease;
        pointer-events: none;
    }

    .floating-tooltip::before {
        content: '';
        position: absolute;
        right: 100%;
        top: 50%;
        transform: translateY(-50%);
        border: 6px solid transparent;
        border-right-color: rgba(31, 41, 55, 0.95);
    }

    .floating-btn:hover .floating-tooltip {
        opacity: 1;
        visibility: visible;
        transform: translateX(0);
    }

    /* RTL Support */
    [dir="rtl"] .floating-actions {
        left: auto;
        right: 30px;
    }

    [dir="rtl"] .floating-tooltip {
        left: auto;
        right: calc(100% + 12px);
        transform: translateX(10px);
    }

    [dir="rtl"] .floating-tooltip::before {
        right: auto;
        left: 100%;
        border-right-color: transparent;
        border-left-color: rgba(31, 41, 55, 0.95);
    }

    [dir="rtl"] .floating-btn:hover .floating-tooltip {
        transform: translateX(0);
    }

    /* Mobile responsive */
    @@media (max-width: 768px) {
        .floating-actions {
            bottom: 20px;
            left: 20px;
            gap: 10px;
        }

        .floating-btn {
            width: 46px;
            height: 46px;
            font-size: 1.2rem;
        }

        .floating-tooltip {
            display: none;
        }

        [dir="rtl"] .floating-actions {
            right: 20px;
        }
    }
</style>
<!-- Start header -->
<header id="header" class="modern-header">
    <div class="wpo-site-header wpo-header-style-3">
        <nav class="navigation navbar navbar-expand-lg navbar-light">
            <div class="container-fluid">
                <div class="navbar-wrapper">
                    <!-- Mobile Menu Toggle -->
                    <div class="mobile-menu-toggle d-lg-none">
                        <button type="button" class="hamburger-btn" id="mobileMenuBtn">
                            <span class="hamburger-line"></span>
                            <span class="hamburger-line"></span>
                            <span class="hamburger-line"></span>
                        </button>
                    </div>

                    <!-- Logo -->
                    <div class="navbar-logo">
                        <a class="navbar-brand logo-animated" asp-controller="Home" asp-action="Index">
                            <img width="60px" src="~/logo/yellow.png" alt="Eventa" />
                        </a>
                    </div>

                    <!-- Desktop Navigation -->
                    <div class="navbar-nav-desktop d-none d-lg-flex">
                        <ul class="nav navbar-nav modern-nav">
                            <li class="nav-item-animated">
                                <a class="nav-link-modern @(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")"
                                   asp-controller="Home" asp-action="Index">
                                    @(isArabic ? "الرئيسية" : "Home")
                                </a>
                            </li>
                            <li class="nav-item-animated">
                                <a class="nav-link-modern @(ViewContext.RouteData.Values["Action"].ToString() == "About" ? "active" : "")"
                                   asp-controller="Home" asp-action="About">
                                    @(isArabic ? "من نحن" : "About")
                                </a>
                            </li>
                            <li class="nav-item-animated">
                                <a class="nav-link-modern @(ViewContext.RouteData.Values["Action"].ToString() == "Designs" ? "active" : "")"
                                   asp-controller="Home" asp-action="Designs">
                                    @(isArabic ? "التصاميم" : "Designs")
                                </a>
                            </li>
                            <li class="nav-item-animated">
                                <a class="nav-link-modern @(ViewContext.RouteData.Values["Action"].ToString().ToLower() == "faqs" ? "active" : "")"
                                   asp-controller="Home" asp-action="FAQs">
                                    @(isArabic ? "الأسئلة الشائعة" : "FAQs")
                                </a>
                            </li>
                            <li class="nav-item-animated">
                                <a class="nav-link-modern @(ViewContext.RouteData.Values["Action"].ToString() == "Contact" ? "active" : "")"
                                   asp-controller="Home" asp-action="Contact">
                                    @(isArabic ? "اتصل بنا" : "Contact")
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Language Switcher -->
                    <div class="navbar-actions">
                        <div class="language-dropdown">
                            <button class="lang-btn" type="button" id="langDropdownBtn">
                                <i class="fas fa-globe"></i>
                                <span class="lang-text">@(isArabic ? "العربية" : "EN")</span>
                                <i class="fas fa-chevron-down chevron-icon"></i>
                            </button>
                            <div class="lang-dropdown-menu" id="langDropdownMenu">
                                <form action="@Url.Action("SetLanguage", "Home")" method="post" id="langForm">
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <input type="hidden" name="culture" id="cultureInput" value="" />
                                    <button type="button" class="lang-option @(isArabic ? "active" : "")" data-culture="ar">
                                        <span class="lang-flag">🇸🇦</span>
                                        <span>العربية</span>
                                        @if (isArabic)
                                        {
                                            <i class="fas fa-check"></i>
                                        }
                                    </button>
                                    <button type="button" class="lang-option @(!isArabic ? "active" : "")" data-culture="en">
                                        <span class="lang-flag">🇺🇸</span>
                                        <span>English</span>
                                        @if (!isArabic)
                                        {
                                            <i class="fas fa-check"></i>
                                        }
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </div>

    <!-- Mobile Menu Overlay -->
    <div class="mobile-menu-overlay" id="mobileMenuOverlay"></div>

    <!-- Mobile Menu Panel -->
    <div class="mobile-menu-panel" id="mobileMenuPanel">
        <div class="mobile-menu-header">
            <a asp-controller="Home" asp-action="Index" class="mobile-logo">
                <img width="50px" src="~/logo/yellow.png" alt="Eventa" />
            </a>
            <button type="button" class="mobile-close-btn" id="mobileCloseBtn">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <nav class="mobile-nav">
            <ul>
                <li>
                    <a class="@(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home"></i>
                        <span>@(isArabic ? "الرئيسية" : "Home")</span>
                    </a>
                </li>
                <li>
                    <a class="@(ViewContext.RouteData.Values["Action"].ToString() == "About" ? "active" : "")"
                       asp-controller="Home" asp-action="About">
                        <i class="fas fa-info-circle"></i>
                        <span>@(isArabic ? "من نحن" : "About")</span>
                    </a>
                </li>
                <li>
                    <a class="@(ViewContext.RouteData.Values["Action"].ToString() == "Designs" ? "active" : "")"
                       asp-controller="Home" asp-action="Designs">
                        <i class="fas fa-palette"></i>
                        <span>@(isArabic ? "التصاميم" : "Designs")</span>
                    </a>
                </li>
                <li>
                    <a class="@(ViewContext.RouteData.Values["Action"].ToString().ToLower() == "faqs" ? "active" : "")"
                       asp-controller="Home" asp-action="FAQs">
                        <i class="fas fa-question-circle"></i>
                        <span>@(isArabic ? "الأسئلة الشائعة" : "FAQs")</span>
                    </a>
                </li>
                <li>
                    <a class="@(ViewContext.RouteData.Values["Action"].ToString() == "Contact" ? "active" : "")"
                       asp-controller="Home" asp-action="Contact">
                        <i class="fas fa-envelope"></i>
                        <span>@(isArabic ? "اتصل بنا" : "Contact")</span>
                    </a>
                </li>
            </ul>
        </nav>
        <div class="mobile-menu-footer">
            <a href="@Url.Action("CreateNew", "Invitations")" class="mobile-cta-btn">
                <i class="fas fa-plus"></i>
                <span>@(isArabic ? "إنشاء دعوة" : "Create Invitation")</span>
            </a>
        </div>
    </div>
</header>

<!-- Modern Header & Navbar Styles -->
<style>
    /* Override legacy sticky-header styles from template's style.css.
       The old code cloned .navigation to create a duplicate sticky header,
       but our modern-header is already position:fixed. We disable the clone
       behavior and prevent any legacy sticky CSS from breaking our header. */
    .modern-header .navigation.sticky-header {
        display: none !important;
    }

    .modern-header .navigation.original {
        /* Undo the 'original' class that the old clone code used to add */
        position: static;
    }

    .modern-header .navigation.sticky-on {
        /* Prevent style.css sticky-on from overriding our header position */
        position: static;
        opacity: 1;
        visibility: visible;
        top: auto;
        box-shadow: none;
    }

    /* Modern Header */
    .modern-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 9999;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .modern-header .wpo-site-header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
        border-bottom: 1px solid rgba(197, 165, 90, 0.1);
    }

    .modern-header.scrolled .wpo-site-header {
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.12);
    }

    /* Navbar Wrapper */
    .navbar-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 0;
        width: 100%;
    }

    /* Logo */
    .navbar-logo {
        flex-shrink: 0;
    }

    .logo-animated {
        display: flex !important;
        align-items: center;
        transition: transform 0.3s ease;
    }

    .logo-animated:hover {
        transform: scale(1.05);
    }

    /* Desktop Navigation */
    .navbar-nav-desktop {
        flex: 1;
        display: flex;
        justify-content: center;
    }

    .modern-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .nav-item-animated {
        position: relative;
    }

    .nav-link-modern {
        position: relative;
        padding: 10px 18px !important;
        font-weight: 500;
        font-size: 0.95rem;
        color: #374151 !important;
        transition: all 0.3s ease;
        border-radius: 25px;
        overflow: hidden;
        text-decoration: none;
        display: block;
    }

    .nav-link-modern::before {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0;
        height: 2px;
        background: linear-gradient(135deg, #C5A55A 0%, #D4BA7A 100%);
        transition: all 0.3s ease;
        transform: translateX(-50%);
        border-radius: 2px;
    }

    .nav-link-modern:hover {
        color: #C5A55A !important;
        background: rgba(197, 165, 90, 0.08);
    }

    .nav-link-modern:hover::before {
        width: 60%;
    }

    .nav-link-modern.active {
        color: #C5A55A !important;
        background: linear-gradient(135deg, rgba(197, 165, 90, 0.12) 0%, rgba(212, 186, 122, 0.08) 100%);
    }

    .nav-link-modern.active::before {
        width: 60%;
    }

    /* Navbar Actions */
    .navbar-actions {
        flex-shrink: 0;
    }

    /* Language Dropdown */
    .language-dropdown {
        position: relative;
    }

    .lang-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        background: linear-gradient(135deg, rgba(197, 165, 90, 0.1) 0%, rgba(212, 186, 122, 0.08) 100%);
        border: 1px solid rgba(197, 165, 90, 0.2);
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 500;
        color: #6b7280;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .lang-btn:hover {
        background: linear-gradient(135deg, rgba(197, 165, 90, 0.15) 0%, rgba(212, 186, 122, 0.12) 100%);
        border-color: rgba(197, 165, 90, 0.3);
        color: #C5A55A;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(197, 165, 90, 0.2);
    }

    .lang-btn .fa-globe {
        color: #C5A55A;
        font-size: 1rem;
        transition: transform 0.3s ease;
    }

    .lang-btn:hover .fa-globe {
        transform: rotate(20deg);
    }

    .lang-btn .chevron-icon {
        font-size: 0.7rem;
        transition: transform 0.3s ease;
        color: #9ca3af;
    }

    .language-dropdown.open .chevron-icon {
        transform: rotate(180deg);
    }

    .lang-dropdown-menu {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        min-width: 180px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        border: 1px solid rgba(197, 165, 90, 0.1);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px) scale(0.95);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        z-index: 10000;
    }

    [dir="rtl"] .lang-dropdown-menu {
        right: auto;
        left: 0;
    }

    .language-dropdown.open .lang-dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
    }

    .lang-option {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 14px 18px;
        background: transparent;
        border: none;
        font-size: 0.95rem;
        color: #374151;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: left;
    }

    [dir="rtl"] .lang-option {
        text-align: right;
    }

    .lang-option:hover {
        background: linear-gradient(135deg, rgba(197, 165, 90, 0.08) 0%, rgba(212, 186, 122, 0.05) 100%);
        color: #C5A55A;
    }

    .lang-option.active {
        background: linear-gradient(135deg, rgba(197, 165, 90, 0.12) 0%, rgba(212, 186, 122, 0.08) 100%);
        color: #C5A55A;
    }

    .lang-option .fa-check {
        margin-left: auto;
        color: #C5A55A;
        font-size: 0.85rem;
    }

    [dir="rtl"] .lang-option .fa-check {
        margin-left: 0;
        margin-right: auto;
    }

    .lang-flag {
        font-size: 1.2rem;
    }

    /* =============================================
       MOBILE STYLES
       ============================================= */

    /* Hamburger Button */
    .mobile-menu-toggle {
        order: -1;
    }

    .hamburger-btn {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        width: 44px;
        height: 44px;
        padding: 10px;
        background: linear-gradient(135deg, rgba(197, 165, 90, 0.1) 0%, rgba(212, 186, 122, 0.08) 100%);
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        gap: 5px;
    }

    .hamburger-btn:hover {
        background: linear-gradient(135deg, rgba(197, 165, 90, 0.15) 0%, rgba(212, 186, 122, 0.12) 100%);
        transform: scale(1.05);
    }

    .hamburger-line {
        width: 22px;
        height: 2.5px;
        background: linear-gradient(135deg, #C5A55A 0%, #D4BA7A 100%);
        border-radius: 2px;
        transition: all 0.3s ease;
    }

    .hamburger-btn.active .hamburger-line:nth-child(1) {
        transform: rotate(45deg) translate(5px, 5px);
    }

    .hamburger-btn.active .hamburger-line:nth-child(2) {
        opacity: 0;
    }

    .hamburger-btn.active .hamburger-line:nth-child(3) {
        transform: rotate(-45deg) translate(5px, -5px);
    }

    /* Mobile Menu Overlay */
    .mobile-menu-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        z-index: 10000;
    }

    .mobile-menu-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    /* Mobile Menu Panel */
    .mobile-menu-panel {
        position: fixed;
        top: 0;
        left: 0;
        width: 85%;
        max-width: 320px;
        height: 100vh;
        background: white;
        box-shadow: 5px 0 30px rgba(0, 0, 0, 0.15);
        transform: translateX(-100%);
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 10001;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
    }

    [dir="rtl"] .mobile-menu-panel {
        left: auto;
        right: 0;
        transform: translateX(100%);
    }

    .mobile-menu-panel.active {
        transform: translateX(0);
    }

    [dir="rtl"] .mobile-menu-panel.active {
        transform: translateX(0);
    }

    /* Mobile Menu Header */
    .mobile-menu-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px;
        border-bottom: 1px solid rgba(197, 165, 90, 0.1);
        background: linear-gradient(135deg, rgba(197, 165, 90, 0.05) 0%, rgba(212, 186, 122, 0.03) 100%);
    }

    .mobile-logo img {
        transition: transform 0.3s ease;
    }

    .mobile-close-btn {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(197, 165, 90, 0.1);
        border: none;
        border-radius: 50%;
        color: #C5A55A;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .mobile-close-btn:hover {
        background: linear-gradient(135deg, #C5A55A 0%, #D4BA7A 100%);
        color: white;
        transform: rotate(90deg);
    }

    /* Mobile Navigation */
    .mobile-nav {
        flex: 1;
        padding: 15px 0;
    }

    .mobile-nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .mobile-nav li {
        margin: 0;
    }

    .mobile-nav a {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 16px 25px;
        color: #374151;
        text-decoration: none;
        font-size: 1rem;
        font-weight: 500;
        transition: all 0.3s ease;
        border-left: 3px solid transparent;
    }

    [dir="rtl"] .mobile-nav a {
        border-left: none;
        border-right: 3px solid transparent;
    }

    .mobile-nav a i {
        width: 24px;
        text-align: center;
        font-size: 1.1rem;
        color: #C5A55A;
        transition: transform 0.3s ease;
    }

    .mobile-nav a:hover {
        background: linear-gradient(135deg, rgba(197, 165, 90, 0.08) 0%, rgba(212, 186, 122, 0.05) 100%);
        color: #C5A55A;
        border-left-color: #C5A55A;
    }

    [dir="rtl"] .mobile-nav a:hover {
        border-left-color: transparent;
        border-right-color: #C5A55A;
    }

    .mobile-nav a:hover i {
        transform: scale(1.1);
    }

    .mobile-nav a.active {
        background: linear-gradient(135deg, rgba(197, 165, 90, 0.12) 0%, rgba(212, 186, 122, 0.08) 100%);
        color: #C5A55A;
        border-left-color: #C5A55A;
    }

    [dir="rtl"] .mobile-nav a.active {
        border-left-color: transparent;
