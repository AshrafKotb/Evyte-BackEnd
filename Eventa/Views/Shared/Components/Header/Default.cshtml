@model HeaderVM

<header class="dashboard-header">
    <!-- Left Section -->
    <div class="header-left">
        <!-- Sidebar Toggle -->
        <button class="sidebar-toggle" id="sidebarToggle">
            <i class="fas fa-bars"></i>
        </button>

        <!-- Search -->
        <div class="header-search">
            <input type="text" placeholder="ابحث هنا..." id="globalSearch">
            <i class="fas fa-search"></i>
        </div>
    </div>

    <!-- Right Section -->
    <div class="header-right">
        <!-- Notifications -->
        <div class="dropdown">
            <button class="header-btn dropdown-toggle" id="notificationsDropdown">
                <i class="fas fa-bell"></i>
                @if (Model.NotificationsNumber > 0)
                {
                    <span class="badge" id="notifications-badge">@Model.NotificationsNumber</span>
                }
            </button>
            <div class="dropdown-menu">
                <div class="dropdown-header">
                    <i class="fas fa-bell"></i>
                    <span>الإشعارات</span>
                    @if (Model.NotificationsNumber > 0)
                    {
                        <span class="badge badge-primary" style="margin-right: auto;">@Model.NotificationsNumber جديد</span>
                    }
                </div>
                <div class="dropdown-body">
                    @if (Model.Notifications != null && Model.Notifications.Count > 0)
                    {
                        @foreach (var notification in Model.Notifications.Take(5))
                        {
                            <a href="#" class="dropdown-item notification-item @(!notification.IsSeen ? "unread" : "")" onclick="MarkNotificationAsSeen('@notification.Id')">
                                <div class="notification-icon" style="width: 40px; height: 40px; background: rgba(99, 102, 241, 0.15); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-info-circle" style="color: #6366f1;"></i>
                                </div>
                                <div style="flex: 1;">
                                    <p style="margin: 0; font-size: 0.9rem; color: #fff;">@notification.Body</p>
                                    <small style="color: #94a3b8;">@notification.CreatedDate.ToString("yyyy/MM/dd hh:mm tt")</small>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="empty-state" style="padding: 40px 20px;">
                            <i class="fas fa-bell-slash" style="font-size: 2rem;"></i>
                            <p style="margin-top: 10px;">لا توجد إشعارات</p>
                        </div>
                    }
                </div>
                @if (Model.Notifications != null && Model.Notifications.Count > 0)
                {
                    <div class="dropdown-footer">
                        <a href="@Url.Action("All", "Notifications")">عرض جميع الإشعارات</a>
                    </div>
                }
            </div>
        </div>

        <!-- Theme Toggle -->
        <button class="header-btn theme-toggle" id="themeToggle" title="تبديل الوضع">
            <i class="fas fa-sun"></i>
            <i class="fas fa-moon"></i>
        </button>

        <!-- Fullscreen Toggle -->
        <button class="header-btn" id="fullscreenToggle" title="ملء الشاشة">
            <i class="fas fa-expand"></i>
        </button>

        <!-- User Menu -->
        <div class="dropdown">
            <div class="header-user dropdown-toggle" id="userDropdown">
                <img src="~/Images/avatar.png" alt="@Model.Name">
                <div class="user-info">
                    <span class="user-name">@Model.Name</span>
                    <span class="user-role">مدير النظام</span>
                </div>
                <i class="fas fa-chevron-down" style="color: #94a3b8; font-size: 0.8rem;"></i>
            </div>
            <div class="dropdown-menu" style="min-width: 220px;">
                <div class="dropdown-header" style="display: flex; align-items: center; gap: 12px;">
                    <img src="~/Images/avatar.png" alt="@Model.Name" style="width: 50px; height: 50px; border-radius: 50%; border: 2px solid #d4a574;">
                    <div>
                        <h4 style="margin: 0; font-size: 1rem;">@Model.Name</h4>
                        <small style="color: #94a3b8;">مدير النظام</small>
                    </div>
                </div>
                <div class="dropdown-body">
                    <a href="@Url.Action("ChangePassword", "cp")" class="dropdown-item">
                        <i class="fas fa-key"></i>
                        <span>تغيير كلمة المرور</span>
                    </a>
                    <a href="#" class="dropdown-item">
                        <i class="fas fa-cog"></i>
                        <span>الإعدادات</span>
                    </a>
                </div>
                <div class="dropdown-footer" style="padding: 0;">
                    <a href="@Url.Action("LogOut", "cp")" class="dropdown-item" style="color: #f43f5e; justify-content: center; border-radius: 0 0 16px 16px;">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>تسجيل الخروج</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
    // Fullscreen Toggle
    document.getElementById('fullscreenToggle')?.addEventListener('click', function() {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen();
            this.querySelector('i').classList.replace('fa-expand', 'fa-compress');
        } else {
            document.exitFullscreen();
            this.querySelector('i').classList.replace('fa-compress', 'fa-expand');
        }
    });

    // Mark Notification As Seen
    function MarkNotificationAsSeen(id) {
        fetch('/Notifications/MarkAsSeen/' + id, { method: 'POST' })
            .then(response => {
                if (response.ok) {
                    const item = document.querySelector(`[onclick="MarkNotificationAsSeen('${id}')"]`);
                    if (item) item.classList.remove('unread');

                    const badge = document.getElementById('notifications-badge');
                    if (badge) {
                        const count = parseInt(badge.textContent) - 1;
                        if (count <= 0) {
                            badge.style.display = 'none';
                        } else {
                            badge.textContent = count;
                        }
                    }
                }
            });
    }
</script>
