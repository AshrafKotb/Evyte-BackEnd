@*
    Splash Resolver: يفحص ViewBag.SplashTemplate ويعرض الـ partial المناسب من Views/Shared/splashes/
    لو مفيش حاجة → يرجع للسبلاش الافتراضي (_EventaDefault).
    بيعيّن window.SPLASH_DURATION_MS عشان splash.js يحترم المدة المحددة.
*@
@using Eventa.Domain.Entities
@{
    var splash = ViewBag.SplashTemplate as SplashTemplate;
    var partialName = (splash != null && !string.IsNullOrWhiteSpace(splash.PartialName))
        ? splash.PartialName
        : "EventaDefault";
    var partialPath = $"splashes/_{partialName}";

    var splashRequest = ViewBag.SplashRequest as Request;
    var durationMs = splash?.DurationMs ?? 3000;
    var requiresInteraction = splash?.RequiresInteraction ?? false;
}

@* عيّن المدة وحالة التفاعل عالميًا قبل ما splash.js يشتغل *@
<script>
    window.SPLASH_DURATION_MS = @durationMs;
    window.SPLASH_REQUIRES_INTERACTION = @(requiresInteraction.ToString().ToLower());
</script>

@{
    Microsoft.AspNetCore.Html.IHtmlContent splashHtml;
    try
    {
        if (splashRequest != null)
        {
            splashHtml = await Html.PartialAsync(partialPath, splashRequest);
        }
        else
        {
            splashHtml = await Html.PartialAsync(partialPath);
        }
    }
    catch
    {
        // لو الـ partial المطلوب مش موجود (اسم غلط في DB)، استخدم الافتراضي
        splashHtml = await Html.PartialAsync("splashes/_EventaDefault");
    }
}
@splashHtml

<script>
    (function () {
        var s = document.getElementById('splashScreen');
        if (!s) return;
        if (window.SPLASH_REQUIRES_INTERACTION) {
            s.dataset.requiresInteraction = 'true';
        }
    })();
</script>

@if (requiresInteraction)
{
    <script>
        (function () {
            var s = document.getElementById('splashScreen');
            if (!s) return;
            s.style.cursor = 'pointer';
            s.addEventListener('click', function () {
                s.style.transition = 'opacity 0.8s ease, transform 0.8s ease';
                s.style.opacity = '0';
                s.style.transform = 'scale(1.05)';
                setTimeout(function () {
                    s.style.display = 'none';
                    s.style.pointerEvents = 'none';
                }, 850);
            });
        })();
    </script>
}
else
{
    <script>
        (function () {
            // في وضع المعاينة (Preview mode)، السبلاش يفضل ظاهر مايختفيش
            if (window.SPLASH_PREVIEW_MODE === true) return;

            // لو splash.js مش متحمل في الصفحة دي، نضمن نخفي السبلاش بنفسنا
            var s = document.getElementById('splashScreen');
            if (!s) return;
            setTimeout(function () {
                if (window.SPLASH_PREVIEW_MODE === true) return; // double-check وقت التنفيذ
                if (s.classList.contains('hidden') || s.style.display === 'none') return;
                s.style.transition = 'opacity 0.6s ease, visibility 0.6s';
                s.style.opacity = '0';
                setTimeout(function () {
                    if (window.SPLASH_PREVIEW_MODE === true) return;
                    s.style.display = 'none';
                    s.style.pointerEvents = 'none';
                }, 650);
            }, @durationMs);
        })();
    </script>
}
