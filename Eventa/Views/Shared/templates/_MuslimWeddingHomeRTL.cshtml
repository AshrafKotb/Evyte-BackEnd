@model Request
@{
    Layout = null;
    var culture = new System.Globalization.CultureInfo("ar-SA");
    culture.DateTimeFormat.Calendar = new System.Globalization.GregorianCalendar();
    var baseDate = DateTime.Today;
    var timeFrom = baseDate.Add(Model.RequestData.EventTimeFrom);
    var timeTo = baseDate.Add(Model.RequestData.EventTimeTo);
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="wpOceans">
    <link rel="shortcut icon" type="image/png" href="~/logo/yellow.png">
    <meta name="description" content="Wedding Invitation @Model.RequestData.BrideName & @Model.RequestData.GroomName" />
    <title>Wedding @Model.RequestData.BrideName & @Model.RequestData.GroomName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700;800;900&family=Noto+Kufi+Arabic:wght@300;400;500;600;700;800;900&family=Sail&display=swap"
          rel="stylesheet">
    <link href="~/assets/css/themify-icons.css" rel="stylesheet">
    <link href="~/assets/css/font-awesome.min.css" rel="stylesheet">
    <link href="~/assets/css/flaticon.css" rel="stylesheet">
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/css/animate.css" rel="stylesheet">
    <link href="~/assets/css/owl.carousel.css" rel="stylesheet">
    <link href="~/assets/css/owl.theme.css" rel="stylesheet">
    <link href="~/assets/css/slick.css" rel="stylesheet">
    <link href="~/assets/css/slick-theme.css" rel="stylesheet">
    <link href="~/assets/css/swiper.min.css" rel="stylesheet">
    <link href="~/assets/css/nice-select.css" rel="stylesheet">
    <link href="~/assets/css/owl.transitions.css" rel="stylesheet">
    <link href="~/assets/css/magnific-popup.css" rel="stylesheet">
    <link href="~/assets/css/jquery.fancybox.css" rel="stylesheet">
    <link href="~/assets/css/odometer-theme-default.css" rel="stylesheet">
    <link href="~/assets/css/jquery-ui.css" rel="stylesheet">
    <link href="~/assets/sass/style.css" rel="stylesheet">
    <link href="~/css/splash-screen.css" rel="stylesheet">
    <link href="~/css/location-section-enhanced.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body dir="rtl" class="rtl-page">

    <!-- start page-wrapper -->
    <div class="page-wrapper">
        <!-- Unified Splash Loader -->
        @await Html.PartialAsync("_SplashLoader")
        <!-- start of hero -->
        <section class="static-hero-s10"
                 style="background: url(/templates/MuslimWeddingHomeRTL/images/hero-bg3.png) no-repeat center center;">
            <div class="hero-container">
                <div class="hero-inner">
                    <div class="container-fluid">
                        <div class="row align-items-center">
                            <div class="col col-xl-5 col-lg-6 col-12">
                                <div class="wpo-static-hero-inner">
                                    <div class="shape-1 wow fadeInUp" data-wow-duration="1400ms">
                                        <img src="~/assets/images/slider/shape16.svg" alt="">
                                    </div>
                                    <div class="slide-title wow fadeInUp" data-wow-duration="1500ms">
                                        <h2>@Model.RequestData.BrideName & @Model.RequestData.GroomName</h2>
                                    </div>
                                    <div data-swiper-parallax="400" class="slide-text wow fadeInUp"
                                         data-wow-duration="1600ms">
                                        <p>سنتزوج في @Model.RequestData.EventDate.ToString("dd MMMM yyyy", culture)</p>
                                    </div>
                                    <div class="wpo-wedding-date wow fadeInUp" data-wow-duration="1700ms">
                                        <div class="clock-grids">
                                            <div id="clock3" data-date="@Model.RequestData.EventDate.Add(Model.RequestData.EventTimeFrom).ToString("yyyy-MM-dd HH:mm:ss")"></div>
                                        </div>
                                    </div>
                                    <div class="shape-2 wow fadeInUp" data-wow-duration="1800ms">
                                        <img src="~/assets/images/slider/shape17.svg" alt="">
                                    </div>
                                    <div class="clearfix"></div>
                                </div>
                            </div>
                            <div class="col-xl-7 col-lg-6 col-12">
                                <div class="wpo-hero-img-wrap">
                                    <div class="wpo-hero-img-item">
                                        <div class="wpo-hero-img" style="mask-image: url(/assets/images/slider/musk.svg); -webkit-mask-image: url(/assets/images/slider/musk.svg);">
                                            <img src="@Model.RequestData.GroomImageUrl" alt="">
                                        </div>
                                        <div class="musk-shape">
                                            <img src="~/assets/images/slider/rtl-shape.png" alt="">
                                        </div>
                                    </div>
                                    <div class="wpo-hero-img-item">
                                        <div class="wpo-hero-img" style="mask-image: url(/assets/images/slider/musk.svg); -webkit-mask-image: url(/assets/images/slider/musk.svg);">
                                            <img src="@Model.RequestData.BrideImageUrl" alt="">
                                        </div>
                                        <div class="musk-shape">
                                            <img src="~/assets/images/slider/rtl-shape.png" alt="">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- end of hero slider -->
        <!-- start wpo-couple-section -->
        <section class="wpo-couple-section-s7 section-padding" id="couple">
            <div class="container">
                <div class="couple-area clearfix">
                    <div class="row align-items-center">
                        <div class="col col-xl-3 col-lg-4 col-12">
                            <div class="text-grid wow fadeInRightSlow" data-wow-duration="800ms">
                                <h3>@Model.RequestData.GroomName</h3>
                                <div class="social">
                                    <ul>
                                        @if (!string.IsNullOrEmpty(Model.RequestData.GroomFacebook))
                                        {
                                            <li><a href="@Model.RequestData.GroomFacebook"><i class="ti-facebook"></i></a></li>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.RequestData.GroomX))
                                        {
                                            <li><a href="@Model.RequestData.GroomX"><i class="ti-twitter-alt"></i></a></li>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.RequestData.GroomInstagram))
                                        {
                                            <li><a href="@Model.RequestData.GroomInstagram"><i class="ti-instagram"></i></a></li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col col-xl-6 col-lg-4 col-12">
                            <div class="middle-couple-pic-wrap">
                                <div class="middle-couple-pic wow zoomIn" data-wow-duration="1000ms">
                                    <div class="middle-couple-pic-inner" style="background: url(/assets/images/couple/couple-mask.jpg) no-repeat center center">
                                        <img src="@Model.RequestData.MainSliderImageUrl" alt="">
                                    </div>
                                    <div class="couple-shape">
                                        <img src="~/assets/images/couple/couple-shape-2.png" alt="">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col col-xl-3 col-lg-4 col-12">
                            <div class="text-grid wow fadeInLeftSlow" data-wow-duration="800ms">
                                <h3>@Model.RequestData.BrideName</h3>
                                <div class="social">
                                    <ul>
                                        @if (!string.IsNullOrEmpty(Model.RequestData.BrideFacebook))
                                        {
                                            <li><a href="@Model.RequestData.BrideFacebook"><i class="ti-facebook"></i></a></li>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.RequestData.BrideX))
                                        {
                                            <li><a href="@Model.RequestData.BrideX"><i class="ti-twitter-alt"></i></a></li>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.RequestData.BrideInstagram))
                                        {
                                            <li><a href="@Model.RequestData.BrideInstagram"><i class="ti-instagram"></i></a></li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div> <!-- end container -->
        </section>
        <!-- end wpo-couple-section -->
        <!-- start wpo-portfolio-section -->
        <section class="wpo-portfolio-section section-padding" id="gallery">
            <h2 class="hidden">some</h2>
            <div class="container-fluid">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="portfolio-grids gallery-container clearfix portfolio-slide owl-carousel">
                            @foreach (var photo in Model.GalleryPhotos)
                            {
                                <div class="grid">
                                    <div class="img-holder">
                                        <a href="@photo.PhotoUrl" class="fancybox"
                                           data-fancybox-group="gall-1">
                                            <img src="@photo.PhotoUrl" alt class="img img-responsive">
                                            <div class="hover-content">
                                                <i class="fas fa-search-plus" aria-hidden="true"></i>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div> <!-- end container -->
        </section>
        <!-- end wpo-portfolio-section -->

        @if (Model.HasMemories && Model.Memories != null && Model.Memories.Any())
        {
            <!-- start wpo-story-section (Memories/Timeline) -->
            <section class="wpo-story-section-s6 section-padding" id="memories">
                <div class="container">
                    <div class="wpo-section-title">
                        <span>رحلتنا معاً</span>
                        <h2>ذكرياتنا</h2>
                    </div>
                    <div class="wpo-story-wrap">
                        <div class="row">
                            @{ var memoryIndex = 0; }
                            @foreach (var memory in Model.Memories.OrderBy(m => m.DisplayOrder))
                            {
                                <div class="col col-lg-12 col-12">
                                    <div class="wpo-story-item @(memoryIndex % 2 == 1 ? "right-item" : "") wow fadeInUp" data-wow-duration="@(1000 + memoryIndex * 200)ms">
                                        <div class="wpo-story-img">
                                            @if (!string.IsNullOrEmpty(memory.ImageUrl))
                                            {
                                                <img src="@memory.ImageUrl" alt="@memory.Title">
                                            }
                                            else
                                            {
                                                <img src="~/assets/images/story/memory-placeholder.png" alt="@memory.Title">
                                            }
                                        </div>
                                        <div class="wpo-story-content">
                                            <span class="date">@memory.EventDate.ToString("dd MMMM yyyy", culture)</span>
                                            <h2>@memory.Title</h2>
                                        </div>
                                    </div>
                                </div>
                                memoryIndex++;
                            }
                        </div>
                    </div>
                </div>
            </section>
            <!-- end wpo-story-section -->
        }

        @if (Model.HasDedications && Model.Dedications != null && Model.Dedications.Any())
        {
            <!-- start wpo-testimonial-section (Dedications) -->
            <section class="wpo-testimonial-section section-padding" id="dedications">
                <div class="container">
                    <div class="wpo-section-title">
                        <span>كلمات الأحبة</span>
                        <h2>إهداءات</h2>
                    </div>
                    <div class="wpo-testimonial-wrap">
                        <div class="row">
                            @foreach (var dedication in Model.Dedications.OrderBy(d => d.DisplayOrder))
                            {
                                <div class="col-lg-4 col-md-6 col-12">
                                    <div class="wpo-testimonial-item wow fadeInUp" data-wow-duration="1000ms">
                                        <div class="wpo-testimonial-content">
                                            <p>"@dedication.Message"</p>
                                        </div>
                                        <div class="wpo-testimonial-info">
                                            <h3>@dedication.PersonName</h3>
                                            @if (!string.IsNullOrEmpty(dedication.Relationship))
                                            {
                                                <span>@dedication.Relationship</span>
                                            }
                                        </div>
                                        <div class="quote-icon">
                                            <i class="fa fa-quote-right"></i>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>
            <!-- end wpo-testimonial-section -->
        }

        <!-- start wpo-event-section -->
        <section class="wpo-event-section-enhanced event-theme-green" id="event">
            <!-- Decorative Elements -->
            <div class="event-decoration event-decoration-1"></div>
            <div class="event-decoration event-decoration-2"></div>

            <div class="container">
                <!-- Section Title -->
                <div class="event-section-title wow fadeInUp" data-wow-duration="800ms">
                    <span class="subtitle">حفل زفافنا</span>
                    <h2>متى وأين</h2>
                </div>

                <!-- Event Card -->
                <div class="event-card-container">
                    <div class="event-card-enhanced wow fadeInUp" data-wow-duration="1000ms" data-wow-delay="200ms">
                        <div class="event-card-inner">
                            <!-- Image Section -->
                            <div class="event-image-wrapper">
                                <img src="@Model.RequestData.EventPlaceImageUrl" alt="مكان الحفل">
                                <div class="event-image-badge">
                                    <i class="fa fa-heart"></i>
                                    <span>الحفل</span>
                                </div>
                            </div>

                            <!-- Details Section -->
                            <div class="event-details-wrapper">
                                <h3 class="event-title">انضموا إلينا</h3>

                                <ul class="event-info-list">
                                    <!-- Date & Time -->
                                    <li class="event-info-item">
                                        <div class="event-info-icon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <div class="event-info-content">
                                            <h4>التاريخ والوقت</h4>
                                            <p>
                                                @Model.RequestData.EventDate.ToString("dddd، dd MMMM yyyy", culture)
                                                <br>
                                                @timeFrom.ToString("hh:mm tt", culture) – @timeTo.ToString("hh:mm tt", culture)
                                            </p>
                                        </div>
                                    </li>

                                    <!-- Venue -->
                                    <li class="event-info-item">
                                        <div class="event-info-icon">
                                            <i class="fa fa-map-marker"></i>
                                        </div>
                                        <div class="event-info-content">
                                            <h4>المكان</h4>
                                            <p>@Model.RequestData.EventPlaceName</p>
                                        </div>
                                    </li>

                                    <!-- Address -->
                                    @if (!string.IsNullOrEmpty(Model.RequestData.EventAddress))
                                    {
                                        <li class="event-info-item">
                                            <div class="event-info-icon">
                                                <i class="fa fa-location-arrow"></i>
                                            </div>
                                            <div class="event-info-content">
                                                <h4>العنوان</h4>
                                                <p>@Model.RequestData.EventAddress</p>
                                            </div>
                                        </li>
                                    }
                                </ul>

                                <!-- Location Button -->
                                <a href="@Model.RequestData.LocationUrl" target="_blank" class="event-location-btn">
                                    <i class="fa fa-map-marker"></i>
                                    الاتجاهات
                                    <i class="fa fa-arrow-left"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- end wpo-event-section -->
        @await Component.InvokeAsync("Footer")
        <!-- color-switcher -->
        <div class="color-switcher-wrap">
            <div class="color-switcher-item">
                <div class="color-toggle-btn">
                    <i class="fa fa-cog"></i>
                </div>
                <ul id="switcher">
                    <li class="btn btn1" id="Button1"></li>
                    <li class="btn btn2" id="Button2"></li>
                    <li class="btn btn3" id="Button3"></li>
                    <li class="btn btn4" id="Button4"></li>
                    <li class="btn btn5" id="Button5"></li>
                    <li class="btn btn6" id="Button6"></li>
                    <li class="btn btn7" id="Button7"></li>
                    <li class="btn btn8" id="Button8"></li>
                    <li class="btn btn9" id="Button9"></li>
                    <li class="btn btn10" id="Button10"></li>
                    <li class="btn btn11" id="Button11"></li>
                    <li class="btn btn12" id="Button12"></li>
                    <li class="btn btn13" id="Button13"></li>
                    <li class="btn btn14" id="Button14"></li>
                    <li class="btn btn15" id="Button15"></li>
                </ul>
            </div>
        </div>

    </div>
    <!-- end of page-wrapper -->

    @if (Model.HasAudio && Model.Audio != null && !string.IsNullOrEmpty(Model.Audio.AudioUrl))
    {
        <!-- Audio Player -->
        <div class="audio-player-floating" id="audioPlayer">
            <audio id="bgMusic" loop>
                <source src="@Model.Audio.AudioUrl" type="audio/mpeg">
            </audio>
            <button class="audio-toggle-btn" id="audioToggle" title="@(Model.Audio.AudioName ?? "موسيقى خلفية")">
                <i class="fa fa-music" id="audioIcon"></i>
            </button>
        </div>

        <style>
            .audio-player-floating {
                position: fixed;
                bottom: 30px;
                left: 30px;
                z-index: 9999;
            }
            .audio-toggle-btn {
                width: 60px;
                height: 60px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--theme-primary-color, #d4a574) 0%, var(--theme-secondary-color, #8b6914) 100%);
                border: none;
                cursor: pointer;
                box-shadow: 0 4px 20px rgba(0,0,0,0.3);
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                justify-content: center;
            }
            .audio-toggle-btn:hover {
                transform: scale(1.1);
                box-shadow: 0 6px 25px rgba(0,0,0,0.4);
            }
            .audio-toggle-btn i {
                color: white;
                font-size: 20px;
            }
            .audio-toggle-btn.playing {
                animation: pulse 1.5s infinite;
            }
            .audio-toggle-btn.playing i {
                animation: musicNote 0.5s infinite alternate;
            }
            @@keyframes pulse {
                0%, 100% { box-shadow: 0 4px 20px rgba(0,0,0,0.3); }
                50% { box-shadow: 0 4px 30px rgba(212, 165, 116, 0.5); }
            }
            @@keyframes musicNote {
                0% { transform: rotate(-10deg); }
                100% { transform: rotate(10deg); }
            }
        </style>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var audio = document.getElementById('bgMusic');
                var toggleBtn = document.getElementById('audioToggle');
                var audioIcon = document.getElementById('audioIcon');
                var autoPlay = @(Model.Audio.AutoPlay.ToString().ToLower());

                function toggleAudio() {
                    if (audio.paused) {
                        audio.play().then(function() {
                            toggleBtn.classList.add('playing');
                            audioIcon.className = 'fa fa-pause';
                        }).catch(function(e) {
                            console.log('Autoplay blocked:', e);
                        });
                    } else {
                        audio.pause();
                        toggleBtn.classList.remove('playing');
                        audioIcon.className = 'fa fa-music';
                    }
                }

                toggleBtn.addEventListener('click', toggleAudio);

                if (autoPlay) {
                    // Try autoplay after user interaction or page load
                    var tryAutoPlay = function() {
                        audio.play().then(function() {
                            toggleBtn.classList.add('playing');
                            audioIcon.className = 'fa fa-pause';
                            document.removeEventListener('click', tryAutoPlay);
                            document.removeEventListener('touchstart', tryAutoPlay);
                        }).catch(function() {});
                    };

                    // Try immediately
                    tryAutoPlay();

                    // Also try on first interaction
                    document.addEventListener('click', tryAutoPlay, { once: true });
                    document.addEventListener('touchstart', tryAutoPlay, { once: true });
                }
            });
        </script>
    }

    <!-- All JavaScript files
    ================================================== -->
    <script src="~/js/splash.js"></script>
    <script src="~/assets/js/jquery.min.js"></script>
    <script src="~/assets/js/bootstrap.bundle.min.js"></script>
    <!-- Plugins for this template -->
    <script src="~/assets/js/modernizr.custom.js"></script>
    <script src="~/assets/js/jquery.pointparallax.min.js"></script>
    <script src="~/assets/js/jquery-plugin-collection.js"></script>
    <script src="~/assets/js/moving-animation.js"></script>
    <script src="~/assets/js/tilt.jquery.min.js"></script>
    <!-- Custom script for this template -->
    <script src="~/assets/js/script.js"></script>
    <script>
        // دالة لتحويل الأرقام الإنجليزية إلى عربية
        function convertToArabicNumerals(number) {
            const arabicNumerals = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];
            return number.toString().replace(/\d/g, (digit) => arabicNumerals[digit]);
        }

        // تحويل جميع الأرقام في العناصر النصية
        function convertNumbersInText() {
            document.querySelectorAll('body *:not(script):not(style)').forEach(element => {
                if (element.childNodes.length === 1 && element.childNodes[0].nodeType === Node.TEXT_NODE) {
                    const text = element.textContent;
                    element.textContent = text.replace(/\d+/g, (num) => convertToArabicNumerals(num));
                }
            });
        }

        // تحويل الوقت في العد التنازلي
        function initWeddingCountdown() {
            if ($("#clock3").length) {
                var weddingDate = $("#clock3").data('date');
                $('#clock3').countdown(weddingDate, function(event) {
                    const days = convertToArabicNumerals(event.strftime('%D'));
                    const hours = convertToArabicNumerals(event.strftime('%H'));
                    const minutes = convertToArabicNumerals(event.strftime('%M'));
                    const seconds = convertToArabicNumerals(event.strftime('%S'));

                    $(this).html(''
                        + '<div class="box"><div><div class="time">' + days + '</div> <span>أيام</span> </div></div>'
                        + '<div class="box"><div><div class="time">' + hours + '</div> <span>ساعات</span> </div></div>'
                        + '<div class="box"><div><div class="time">' + minutes + '</div> <span>دقيقة</span> </div></div>'
                        + '<div class="box"><div><div class="time">' + seconds + '</div> <span>ثانية</span> </div></div>');
                }).on('finish.countdown', function() {
                    $(this).html('<div class="countdown-ended">لقد بدأ الحفل!</div>');
                });
            }
        }

        // تنفيذ التحويل عند تحميل الصفحة
        $(document).ready(function() {
            convertNumbersInText();
            initWeddingCountdown();
        });
    </script>
</body>

</html>