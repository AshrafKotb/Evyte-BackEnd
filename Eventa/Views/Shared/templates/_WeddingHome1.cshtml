@model Request
@{
    Layout = null;
    var culture = new System.Globalization.CultureInfo("en-SA");
    culture.DateTimeFormat.Calendar = new System.Globalization.GregorianCalendar();
    var baseDate = DateTime.Today;
    var timeFrom = baseDate.Add(Model.RequestData.EventTimeFrom);
    var timeTo = baseDate.Add(Model.RequestData.EventTimeTo);
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="wpOceans">
    <link rel="shortcut icon" type="image/png" href="~/logo/yellow.png">
    <meta name="description" content="Wedding Invitation @Model.RequestData.BrideName & @Model.RequestData.GroomName" />
    <title>Wedding @Model.RequestData.BrideName & @Model.RequestData.GroomName</title>

    <link href="~/assets/css/themify-icons.css" rel="stylesheet">
    <link href="~/assets/css/font-awesome.min.css" rel="stylesheet">
    <link href="~/assets/css/flaticon.css" rel="stylesheet">
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/css/animate.css" rel="stylesheet">
    <link href="~/assets/css/owl.carousel.css" rel="stylesheet">
    <link href="~/assets/css/owl.theme.css" rel="stylesheet">
    <link href="~/assets/css/slick.css" rel="stylesheet">
    <link href="~/assets/css/slick-theme.css" rel="stylesheet">
    <link href="~/assets/css/swiper.min.css" rel="stylesheet">
    <link href="~/assets/css/nice-select.css" rel="stylesheet">
    <link href="~/assets/css/owl.transitions.css" rel="stylesheet">
    <link href="~/assets/css/magnific-popup.css" rel="stylesheet">
    <link href="~/assets/css/jquery.fancybox.css" rel="stylesheet">
    <link href="~/assets/css/odometer-theme-default.css" rel="stylesheet">
    <link href="~/assets/css/jquery-ui.css" rel="stylesheet">
    <link href="~/assets/sass/style.css" rel="stylesheet">
    <link href="~/css/splash-screen.css" rel="stylesheet">
    <link href="~/css/wedding-home1-enhanced.css" rel="stylesheet">
    <link href="~/css/location-section-enhanced.css" rel="stylesheet">
    @if (ViewBag.IsEditorMode == true)
    {
        <link href="~/css/editor.css" rel="stylesheet">
    }
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
    <!-- Scroll Progress Indicator -->
    <div class="scroll-progress" id="scrollProgress"></div>

    <!-- Floating Hearts -->
    <div class="floating-hearts-container">
        <span class="floating-heart"><i class="fa fa-heart"></i></span>
        <span class="floating-heart"><i class="fa fa-heart"></i></span>
        <span class="floating-heart"><i class="fa fa-heart"></i></span>
        <span class="floating-heart"><i class="fa fa-heart"></i></span>
        <span class="floating-heart"><i class="fa fa-heart"></i></span>
        <span class="floating-heart"><i class="fa fa-heart"></i></span>
        <span class="floating-heart"><i class="fa fa-heart"></i></span>
        <span class="floating-heart"><i class="fa fa-heart"></i></span>
    </div>

    <!-- Confetti Container -->
    <div class="confetti-container" id="confettiContainer"></div>

    <!-- Sticky Navigation -->
    <nav class="wedding-nav" id="weddingNav">
        <div class="nav-container">
            <div class="couple-names">@Model.RequestData.GroomName & @Model.RequestData.BrideName</div>
            <ul class="nav-links">
                <li><a href="#couple">The Couple</a></li>
                <li><a href="#gallery">Gallery</a></li>
                @if (Model.HasMemories && Model.Memories != null && Model.Memories.Any())
                {
                    <li><a href="#memories">Our Story</a></li>
                }
                @if (Model.HasDedications && Model.Dedications != null && Model.Dedications.Any())
                {
                    <li><a href="#dedications">Wishes</a></li>
                }
                <li><a href="#event">Event</a></li>
            </ul>
        </div>
    </nav>

    <!-- Share Buttons -->
    <div class="share-buttons-container">
        <a id="whatsappShareBtn" href="#" class="share-btn whatsapp" title="Share on WhatsApp">
            <i class="fa fa-whatsapp"></i>
        </a>
        <a id="facebookShareBtn" href="#" class="share-btn facebook" title="Share on Facebook">
            <i class="fa fa-facebook"></i>
        </a>
        <a id="twitterShareBtn" href="#" class="share-btn twitter" title="Share on Twitter">
            <i class="fa fa-twitter"></i>
        </a>
        <button class="share-btn copy-link" id="copyLinkBtn" title="Copy Link">
            <i class="fa fa-link"></i>
        </button>
        @if (!string.IsNullOrEmpty(Model.QrCodeImageUrl))
        {
            <button class="share-btn qr-code" id="qrCodeBtn" title="QR Code">
                <i class="fa fa-qrcode"></i>
            </button>
        }
    </div>

    <!-- QR Code Modal -->
    @if (!string.IsNullOrEmpty(Model.QrCodeImageUrl))
    {
        <div class="qr-modal-overlay" id="qrModalOverlay">
            <div class="qr-modal">
                <button class="qr-modal-close" id="qrModalClose">&times;</button>
                <h3>Scan or Share QR Code</h3>
                <div class="qr-image-container">
                    <img src="@Model.QrCodeImageUrl" alt="Wedding Invitation QR Code" id="qrCodeImage">
                </div>
                <div class="qr-modal-actions">
                    <button class="qr-action-btn download" id="downloadQrBtn">
                        <i class="fa fa-download"></i> Download
                    </button>
                    <button class="qr-action-btn share-whatsapp" id="shareQrWhatsapp">
                        <i class="fa fa-whatsapp"></i> WhatsApp
                    </button>
                    <button class="qr-action-btn share-native" id="shareQrNative">
                        <i class="fa fa-share-alt"></i> Share
                    </button>
                </div>
            </div>
        </div>

        <style>
            .share-btn.qr-code { background: linear-gradient(135deg, #333 0%, #666 100%); }
            .share-btn.qr-code:hover { background: linear-gradient(135deg, #444 0%, #777 100%); }

            .qr-modal-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.8);
                display: none;
                justify-content: center;
                align-items: center;
                z-index: 99999;
                opacity: 0;
                transition: opacity 0.3s ease;
            }
            .qr-modal-overlay.active {
                display: flex;
                opacity: 1;
            }
            .qr-modal {
                background: white;
                padding: 30px;
                border-radius: 20px;
                text-align: center;
                max-width: 400px;
                width: 90%;
                position: relative;
                transform: scale(0.8);
                transition: transform 0.3s ease;
            }
            .qr-modal-overlay.active .qr-modal {
                transform: scale(1);
            }
            .qr-modal-close {
                position: absolute;
                top: 10px;
                right: 15px;
                background: none;
                border: none;
                font-size: 28px;
                cursor: pointer;
                color: #666;
                transition: color 0.3s;
            }
            .qr-modal-close:hover { color: #333; }
            .qr-modal h3 {
                margin: 0 0 20px;
                color: #333;
                font-family: 'Great Vibes', cursive;
                font-size: 28px;
            }
            .qr-image-container {
                background: #f8f8f8;
                padding: 20px;
                border-radius: 15px;
                margin-bottom: 20px;
            }
            .qr-image-container img {
                max-width: 200px;
                width: 100%;
                height: auto;
            }
            .qr-modal-actions {
                display: flex;
                gap: 10px;
                justify-content: center;
                flex-wrap: wrap;
            }
            .qr-action-btn {
                padding: 12px 20px;
                border: none;
                border-radius: 25px;
                cursor: pointer;
                font-size: 14px;
                display: flex;
                align-items: center;
                gap: 8px;
                transition: all 0.3s ease;
                color: white;
            }
            .qr-action-btn.download {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            }
            .qr-action-btn.share-whatsapp {
                background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
            }
            .qr-action-btn.share-native {
                background: linear-gradient(135deg, var(--theme-primary-color, #d4a574) 0%, var(--theme-secondary-color, #8b6914) 100%);
            }
            .qr-action-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            }
        </style>
    }

    <!-- start page-wrapper -->
    <div class="page-wrapper">
        <!-- Unified Splash Loader -->
        @await Html.PartialAsync("_SplashLoader")
        <!-- start of hero -->
        <section class="static-hero-s2">
            <div class="hero-container">
                <div class="hero-inner">
                    <div class="container-fluid">
                        <div class="row align-items-center">
                            <div class="col-xl-6 col-lg-6 col-12">
                                <div class="wpo-static-hero-inner">
                                    <div class="slide-title-sub wow fadeInUp" data-wow-duration="1400ms">
                                        <h3><span data-editor-field="GroomName" data-editor-type="text">@Model.RequestData.GroomName</span> & <span data-editor-field="BrideName" data-editor-type="text">@Model.RequestData.BrideName</span></h3>
                                    </div>
                                    <div class="slide-title wow fadeInUp" data-wow-duration="1500ms">
                                        <h2>Save the Date</h2>
                                    </div>
                                    <div data-swiper-parallax="400" class="slide-text wow fadeInUp"
                                         data-wow-duration="1600ms">
                                        <p>We Are Getting Married <span data-editor-field="EventDate" data-editor-type="date">@Model.RequestData.EventDate.ToString("dd MMMM yyyy", culture)</span></p>
                                    </div>
                                    <!-- Countdown Timer -->
                                    <div class="countdown-container">
                                        <div class="countdown-wrapper" id="weddingCountdown" data-date="@Model.RequestData.EventDate.ToString("yyyy-MM-dd")">
                                            <div class="countdown-item">
                                                <div class="countdown-number" id="countdownDays">00</div>
                                                <span class="countdown-label">Days</span>
                                            </div>
                                            <div class="countdown-item">
                                                <div class="countdown-number" id="countdownHours">00</div>
                                                <span class="countdown-label">Hours</span>
                                            </div>
                                            <div class="countdown-item">
                                                <div class="countdown-number" id="countdownMinutes">00</div>
                                                <span class="countdown-label">Minutes</span>
                                            </div>
                                            <div class="countdown-item">
                                                <div class="countdown-number" id="countdownSeconds">00</div>
                                                <span class="countdown-label">Seconds</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="shape-2 wow fadeInUp" data-wow-duration="1800ms">
                                        <img src="~/assets/images/slider/shape2.svg" alt="">
                                    </div>
                                    <!-- Sparkle Decorations -->
                                    <div class="sparkle-decoration">
                                        <div class="sparkle"></div>
                                        <div class="sparkle"></div>
                                        <div class="sparkle"></div>
                                        <div class="sparkle"></div>
                                        <div class="sparkle"></div>
                                        <div class="sparkle"></div>
                                    </div>
                                    <div class="clearfix"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="static-hero-right">
                <div class="static-hero-img scene" id="scene">
                    <div class="static-hero-img-inner">
                        <img class="zoom" data-editor-field="MainSliderImage" data-editor-type="image" src="@Model.RequestData.MainSliderImageUrl" alt="">
                        <div class="hero-img-inner-shape">
                            <img src="~/assets/images/slider/shape9.svg" alt="">
                        </div>
                        <div class="hero-img-inner-shape-2">
                            <img src="~/assets/images/slider/shape10.svg" alt="">
                        </div>
                    </div>
                    <div class="static-hero-shape-1 wow fadeInUp" data-wow-delay=".5s">
                        <img src="~/assets/images/slider/shape7.svg" alt="">
                    </div>
                    <div class="static-hero-shape-2 wow fadeInDown" data-wow-delay=".5s">
                        <img src="~/assets/images/slider/shape8.svg" alt="">
                    </div>
                    <div class="inner-image-1">
                        <span class="layer" data-depth="0.25">
                            <img data-editor-field="BrideImage" data-editor-type="image" src="@Model.RequestData.BrideImageUrl" alt="">
                        </span>
                    </div>
                    <div class="inner-image-2">
                        <span class="layer" data-depth="0.45">
                            <img data-editor-field="GroomImage" data-editor-type="image" src="@Model.RequestData.GroomImageUrl" alt="">
                        </span>
                    </div>
                </div>
            </div>
            <div class="left-shape">
                <div class="left-shape-1">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 177 383" fill="none">
                        <path d="M167.726 404.933C178.762 383.436 180.815 359.362 167.119 341.847C147.887 317.271 96.7324 307.231 84.7796 280.695C77.4608 264.444 87.5548 247.29 95.5965 231.18C105.368 211.617 112.299 191.009 109.447 170.492C106.594 149.975 92.8858 129.419 67.8444 117.214C52.3548 109.662 31.5859 104.223 26.2291 91.9796C23.3377 85.3811 25.8806 78.3444 27.5715 71.5654C31.7795 54.7211 30.6307 37.2969 24.2155 20.7619C22.0211 15.1041 19.0136 9.33044 12.7016 5.2579C6.38957 1.19826 -4.06587 -0.567362 -11.3847 2.68035C-19.4392 6.25026 -20.317 13.738 -20.3944 20.1561C-20.7946 53.4581 -21.1947 86.7472 -21.5949 120.049C-22.8857 227.288 -24.1636 334.514 -23.9828 441.753C-23.9699 445.761 -23.686 450.233 -19.3489 453.017C-15.5798 455.453 -9.86154 455.853 -4.608 456.059C28.0749 457.412 81.8624 461.91 112.583 453.017C135.534 446.393 156.38 427.036 167.726 404.933Z"
