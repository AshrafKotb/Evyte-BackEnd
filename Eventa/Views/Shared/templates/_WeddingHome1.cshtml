        <style>
            .audio-player-floating { position: fixed; bottom: 30px; right: 30px; z-index: 9999; }
            .audio-toggle-btn { width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, var(--theme-primary-color, #d4a574) 0%, var(--theme-secondary-color, #8b6914) 100%); border: none; cursor: pointer; box-shadow: 0 4px 20px rgba(0,0,0,0.3); transition: all 0.3s ease; display: flex; align-items: center; justify-content: center; }
            .audio-toggle-btn:hover { transform: scale(1.1); box-shadow: 0 6px 25px rgba(0,0,0,0.4); }
            .audio-toggle-btn i { color: white; font-size: 20px; }
            .audio-toggle-btn.playing { animation: pulse 1.5s infinite; }
            .audio-toggle-btn.playing i { animation: musicNote 0.5s infinite alternate; }
            @@keyframes pulse { 0%, 100% { box-shadow: 0 4px 20px rgba(0,0,0,0.3); } 50% { box-shadow: 0 4px 30px rgba(212, 165, 116, 0.5); } }
            @@keyframes musicNote { 0% { transform: rotate(-10deg); } 100% { transform: rotate(10deg); } }
        </style>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var audio = document.getElementById('bgMusic'), toggleBtn = document.getElementById('audioToggle'), audioIcon = document.getElementById('audioIcon'), autoPlay = @(Model.Audio.AutoPlay.ToString().ToLower());
                function toggleAudio() { if (audio.paused) { audio.play().then(function() { toggleBtn.classList.add('playing'); audioIcon.className = 'fa fa-pause'; }).catch(function(e) { console.log('Autoplay blocked:', e); }); } else { audio.pause(); toggleBtn.classList.remove('playing'); audioIcon.className = 'fa fa-music'; } }
                toggleBtn.addEventListener('click', toggleAudio);
                if (autoPlay) { var tryAutoPlay = function() { audio.play().then(function() { toggleBtn.classList.add('playing'); audioIcon.className = 'fa fa-pause'; document.removeEventListener('click', tryAutoPlay); document.removeEventListener('touchstart', tryAutoPlay); }).catch(function() {}); }; tryAutoPlay(); document.addEventListener('click', tryAutoPlay, { once: true }); document.addEventListener('touchstart', tryAutoPlay, { once: true }); }
            });
        </script>
    }

