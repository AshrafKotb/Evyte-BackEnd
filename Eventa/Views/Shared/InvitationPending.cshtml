@model Request
@{
    Layout = "~/Views/Shared/_LayoutMinimal.cshtml";
    ViewData["Title"] = "دعوتك قيد المراجعة";
}

<h1><i class="fas fa-clock text-info me-2"></i>دعوتك قيد المراجعة</h1>
<p>دعوتك الخاصة بـ <strong>@Model.RequestData?.BrideName</strong> و <strong>@Model.RequestData?.GroomName</strong> قيد المراجعة حالياً من قبل فريقنا.</p>
<p class="mb-2">سنقوم بمراجعة طلبك بعناية وسنخطرك فور الموافقة عليه. عادةً ما تستغرق هذه العملية من 24 إلى 48 ساعة.</p>
@if (Model?.User != null)
{
    <p class="small text-muted">يمكنك متابعة حالة دعوتك عبر البريد الإلكتروني: <strong>@Model.User.Email</strong></p>
}