@model ErrorViewModel
@{
    Layout = "~/Views/Shared/_LayoutMinimal.cshtml";
    ViewData["Title"] = "حدث خطأ";
}

<h1><i class="fas fa-exclamation-circle text-warning me-2"></i>حدث خطأ</h1>
<p class="mb-2">عذراً، حدث خطأ أثناء معالجة طلبك. يرجى المحاولة لاحقاً أو العودة للصفحة الرئيسية.</p>
@if (Model?.ShowRequestId == true && !string.IsNullOrEmpty(Model.RequestId))
{
    <p class="small text-muted mb-0">رقم الطلب: <code>@Model.RequestId</code></p>
}
