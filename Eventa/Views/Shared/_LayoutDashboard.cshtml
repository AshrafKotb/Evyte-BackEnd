<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <title>Eventa | @ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="description" content="لوحة تحكم Eventa - إدارة الدعوات الإلكترونية">
    <link rel="icon" type="image/png" href="~/logo/yellow.png">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/css/dashboard.css?v=@DateTime.Now.Ticks">
    <link rel="stylesheet" href="~/css/splash-screen.css?v=@DateTime.Now.Ticks">

    <!-- Plugins CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">

    <!-- Select2 RTL Fix -->
    <style>
        /* Select2 - Dark Mode (Default) */
        .select2-container--default .select2-selection--single,
        .select2-container--default .select2-selection--multiple {
            background: var(--input-bg, rgba(255, 255, 255, 0.05));
            border: 2px solid var(--input-border, rgba(255, 255, 255, 0.1));
            border-radius: 12px;
            min-height: 48px;
            padding: 8px 12px;
            transition: all 0.3s ease;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: var(--input-text, #fff);
            line-height: 30px;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 46px;
        }
        .select2-dropdown {
            background: var(--bg-secondary, #1a1a2e);
            border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
            border-radius: 12px;
            box-shadow: var(--shadow-xl);
        }
        .select2-container--default .select2-results__option--highlighted[aria-selected] {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .select2-container--default .select2-results__option {
            color: var(--text-secondary, #cbd5e1);
            padding: 10px 15px;
        }
        .select2-container--default .select2-search--dropdown .select2-search__field {
            background: var(--input-bg, rgba(255, 255, 255, 0.05));
            border: 1px solid var(--input-border, rgba(255, 255, 255, 0.1));
            border-radius: 8px;
            color: var(--input-text, #fff);
            padding: 10px;
        }

        /* DataTables RTL Fixes */
        .dataTables_wrapper {
            direction: rtl;
        }
        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            color: var(--text-muted, #94a3b8);
        }
        .dataTables_wrapper .dataTables_filter input,
        .dataTables_wrapper .dataTables_length select {
            background: var(--input-bg, rgba(255, 255, 255, 0.05));
            border: 1px solid var(--input-border, rgba(255, 255, 255, 0.1));
            border-radius: 8px;
            color: var(--input-text, #fff);
            padding: 8px 12px;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            background: var(--glass-bg, rgba(255, 255, 255, 0.05));
            border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
            border-radius: 8px;
            color: var(--text-secondary, #cbd5e1) !important;
            margin: 0 4px;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.current,
        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
            border-color: transparent !important;
            color: #fff !important;
        }

        /* Summernote Fix */
        .note-editor.note-frame {
            border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
            border-radius: 12px;
            overflow: hidden;
        }
        .note-editor .note-toolbar {
            background: var(--glass-bg, rgba(255, 255, 255, 0.05));
            border-bottom: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
        }
        .note-editor .note-editing-area .note-editable {
            background: var(--input-bg, rgba(255, 255, 255, 0.02));
            color: var(--input-text, #fff);
        }

        /* Light Mode Select2 Overrides */
        [data-theme="light"] .select2-container--default .select2-selection--single,
        [data-theme="light"] .select2-container--default .select2-selection--multiple {
            background: #ffffff;
            border-color: #e2e8f0;
        }
        [data-theme="light"] .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #0f172a;
        }
        [data-theme="light"] .select2-dropdown {
            background: #ffffff;
            border-color: #e2e8f0;
        }
        [data-theme="light"] .select2-container--default .select2-results__option {
            color: #334155;
        }
        [data-theme="light"] .select2-container--default .select2-search--dropdown .select2-search__field {
            background: #ffffff;
            border-color: #e2e8f0;
            color: #0f172a;
        }
        [data-theme="light"] .dataTables_wrapper .dataTables_filter input,
        [data-theme="light"] .dataTables_wrapper .dataTables_length select {
            background: #ffffff;
            border-color: #e2e8f0;
            color: #0f172a;
        }
        [data-theme="light"] .dataTables_wrapper .dataTables_paginate .paginate_button {
            background: #ffffff;
            border-color: #e2e8f0;
            color: #334155 !important;
        }
        [data-theme="light"] .note-editor .note-toolbar {
            background: #f8fafc;
            border-bottom-color: #e2e8f0;
        }
        [data-theme="light"] .note-editor .note-editing-area .note-editable {
            background: #ffffff;
            color: #0f172a;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Professional Splash Screen (Unified) -->
    @await Html.PartialAsync("_SplashLoader")

    <!-- INLINE splash killer: guaranteed to run even if CDN scripts fail -->
    <script>
        (function(){
            var s = document.getElementById('splashScreen');
            if (!s) return;
            function killSplash() {
                s.style.transition = 'opacity 0.6s ease';
                s.style.opacity = '0';
                setTimeout(function(){
                    s.style.display = 'none';
                    // Also hide loading spinner
                    var sp = document.getElementById('loading-spinner');
                    if (sp) { sp.style.opacity = '0'; sp.style.visibility = 'hidden'; }
                }, 700);
            }
            // Kill splash after 4 seconds no matter what
            setTimeout(killSplash, 4000);
            // Also try on load (faster)
            window.addEventListener('load', function(){ setTimeout(killSplash, 1000); });
        })();
    </script>

    <!-- Loading Spinner -->
    <div id="loading-spinner" class="loading-spinner">
        <div class="spinner"></div>
    </div>

    <div class="dashboard-wrapper">
        <!-- Sidebar -->
        @await Component.InvokeAsync("AdminSideMenu")

        <!-- Main Content -->
        <div class="dashboard-main">
            <!-- Header -->
            @await Component.InvokeAsync("Header")

            <!-- Content -->
            <div class="dashboard-content">
                @RenderBody()
            </div>
        </div>

        <!-- Mobile Overlay -->
        <div class="overlay" id="sidebar-overlay"></div>
    </div>

    <!-- Core Scripts -->
    <script src="~/js/splash.js?v=@DateTime.Now.Ticks"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Plugins Scripts -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Summernote -->
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>

    <!-- Dashboard Scripts -->
    <script>
        // Global Configuration
        const Dashboard = {
            init() {
                try {
                    this.initTheme();
                    this.initSidebar();
                    this.initDropdowns();
                } catch(e) { console.warn('Dashboard basic init error:', e); }
                try {
                    this.initToastr();
                } catch(e) { console.warn('Toastr init error:', e); }
                try {
                    this.initSelect2();
                } catch(e) { console.warn('Select2 init error:', e); }
                try {
                    this.initDataTables();
                } catch(e) { console.warn('DataTables init error:', e); }
                // Always hide loading - even if plugins failed
                this.hideLoading();
            },

            // Theme Toggle
            initTheme() {
                const html = document.documentElement;
                const themeToggle = document.getElementById('themeToggle');

                // Load saved theme from localStorage
                const savedTheme = localStorage.getItem('eventa-theme') || 'dark';
                html.setAttribute('data-theme', savedTheme);

                if (themeToggle) {
                    themeToggle.addEventListener('click', () => {
                        const currentTheme = html.getAttribute('data-theme');
                        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

                        html.setAttribute('data-theme', newTheme);
                        localStorage.setItem('eventa-theme', newTheme);

                        // Update SweetAlert2 theme
                        this.updateSwalTheme(newTheme);
                    });
                }
            },

            // Update SweetAlert2 theme
            updateSwalTheme(theme) {
                const isDark = theme === 'dark';
                Swal.update({
                    background: isDark ? '#1a1a2e' : '#ffffff',
                    color: isDark ? '#fff' : '#0f172a'
                });
            },

            // Sidebar Toggle
            initSidebar() {
                const sidebar = document.querySelector('.sidebar');
                const sidebarToggle = document.querySelector('.sidebar-toggle');
                const overlay = document.getElementById('sidebar-overlay');

                if (sidebarToggle) {
                    sidebarToggle.addEventListener('click', () => {
                        sidebar.classList.toggle('open');
                        sidebar.classList.toggle('collapsed');
                    });
                }

                if (overlay) {
                    overlay.addEventListener('click', () => {
                        sidebar.classList.remove('open');
                    });
                }

                // Submenu Toggle
                document.querySelectorAll('.nav-item.has-submenu > .nav-link').forEach(link => {
                    link.addEventListener('click', (e) => {
                        e.preventDefault();
                        const parent = link.parentElement;
                        parent.classList.toggle('open');
                    });
                });
            },

            // Dropdowns
            initDropdowns() {
                document.querySelectorAll('.dropdown').forEach(dropdown => {
                    const toggle = dropdown.querySelector('.dropdown-toggle');
                    if (toggle) {
                        toggle.addEventListener('click', (e) => {
                            e.stopPropagation();
                            dropdown.classList.toggle('open');
                        });
                    }
                });

                document.addEventListener('click', () => {
                    document.querySelectorAll('.dropdown.open').forEach(d => d.classList.remove('open'));
                });
            },

            // Toastr Configuration
            initToastr() {
                toastr.options = {
                    closeButton: true,
                    progressBar: true,
                    positionClass: 'toast-top-left',
                    timeOut: 4000,
                    rtl: true
                };
            },

            // Select2
            initSelect2() {
                if ($.fn.select2) {
                    $('.select2').select2({
                        dir: 'rtl',
                        placeholder: 'اختر...',
                        allowClear: true
                    });
                }
            },

            // DataTables
            initDataTables() {
                if ($.fn.DataTable) {
                    $('.data-table').DataTable({
                        language: {
                            url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json'
                        },
                        responsive: true,
                        pageLength: 10
                    });
                }
            },

            // Hide Loading
            hideLoading() {
                setTimeout(() => {
                    document.getElementById('loading-spinner').classList.add('hidden');
                }, 500);
            },

            // Show Loading
            showLoading() {
                document.getElementById('loading-spinner').classList.remove('hidden');
            },

            // Success Toast
            success(message) {
                toastr.success(message);
            },

            // Error Toast
            error(message) {
                toastr.error(message);
            },

            // Confirm Dialog
            confirm(title, text, callback) {
                Swal.fire({
                    title: title,
                    text: text,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#6366f1',
                    cancelButtonColor: '#f43f5e',
                    confirmButtonText: 'نعم',
                    cancelButtonText: 'إلغاء',
                    background: '#1a1a2e',
                    color: '#fff'
                }).then((result) => {
                    if (result.isConfirmed && callback) {
                        callback();
                    }
                });
            }
        };

        // Initialize Dashboard
        document.addEventListener('DOMContentLoaded', () => {
            Dashboard.init();
        });

        // Splash Screen (handled by splash.js)

        // Form Submit Loading
        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', function() {
                if (this.checkValidity()) {
                    Dashboard.showLoading();
                }
            });
        });

        // AJAX Setup - only show loading for non-GET requests
        try {
            if (typeof $ !== 'undefined' && $.ajaxSetup) {
                $.ajaxSetup({
                    beforeSend: function(jqXHR, settings) {
                        if (settings.type && settings.type.toUpperCase() !== 'GET') {
                            Dashboard.showLoading();
                        }
                    },
                    complete: function() {
                        Dashboard.hideLoading();
                    }
                });
            }
        } catch(e) { console.warn('AJAX setup error:', e); }
    </script>

    @if (TempData["Success"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                toastr.success('@TempData["Success"]');
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                toastr.error('@TempData["Error"]');
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
