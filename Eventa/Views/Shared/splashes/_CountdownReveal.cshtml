@*
    Cinematic 3-2-1 countdown then bold name reveal with shockwave.
    PartialName: CountdownReveal
*@
@model Request
@{
    var rd = Model?.RequestData;
    var names = !string.IsNullOrEmpty(rd?.GroomName) && !string.IsNullOrEmpty(rd?.BrideName)
        ? $"{rd.GroomName} & {rd.BrideName}"
        : "The Wedding";
}
<div class="splash-screen splash-count" id="splashScreen">
    <div class="splash-count__rings">
        <span></span><span></span><span></span>
    </div>

    <div class="splash-count__num splash-count__num--3">3</div>
    <div class="splash-count__num splash-count__num--2">2</div>
    <div class="splash-count__num splash-count__num--1">1</div>

    <!-- Hearts burst with shockwave -->
    <div class="splash-count__hearts">
        @for (int i = 0; i < 16; i++)
        {
            <span class="splash-count__heart" style="--angle:@(i * 22.5)deg;">♥</span>
        }
    </div>

    <div class="splash-count__reveal">
        <div class="splash-count__shockwave"></div>
        <div class="splash-count__reveal-inner">
            <span class="splash-count__eyebrow">YOU'RE INVITED TO</span>
            <h1 class="splash-count__title">@names</h1>
            @if (rd != null)
            {
                <span class="splash-count__date">@rd.EventDate.ToString("dddd, dd MMMM yyyy")</span>
            }
        </div>
    </div>
</div>

<style>
    .splash-count {
        background:
            radial-gradient(circle at center, #1a1a2e 0%, #0a0a14 100%);
        overflow: hidden;
        animation: none !important;
    }

    .splash-count__rings {
        position: absolute; top: 50%; left: 50%;
        width: 0; height: 0;
    }
    .splash-count__rings span {
        position: absolute; top: 50%; left: 50%;
        border: 2px solid rgba(212,165,116,0.4);
        border-radius: 50%;
        animation: spcntRing 1s ease-in-out infinite;
    }
    .splash-count__rings span:nth-child(1) { width: 100px; height: 100px; margin: -50px 0 0 -50px; animation-delay: 0s; }
    .splash-count__rings span:nth-child(2) { width: 200px; height: 200px; margin: -100px 0 0 -100px; animation-delay: 0.2s; }
    .splash-count__rings span:nth-child(3) { width: 300px; height: 300px; margin: -150px 0 0 -150px; animation-delay: 0.4s; }
    @@keyframes spcntRing {
        0% { transform: scale(0.5); opacity: 1; }
        100% { transform: scale(1.5); opacity: 0; }
    }

    .splash-count__num {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        font-family: 'Playfair Display', serif;
        font-size: 18rem; font-weight: 900;
        color: transparent;
        -webkit-text-stroke: 3px #d4a574;
        text-stroke: 3px #d4a574;
        opacity: 0;
        line-height: 1;
        text-shadow: 0 0 40px rgba(212,165,116,0.4);
    }
    .splash-count__num--3 { animation: spcntNum 1s ease forwards 0s; }
    .splash-count__num--2 { animation: spcntNum 1s ease forwards 1s; }
    .splash-count__num--1 { animation: spcntNum 1s ease forwards 2s; }
    @@keyframes spcntNum {
        0% { opacity: 0; transform: translate(-50%, -50%) scale(2); }
        30% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        70% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        100% { opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
    }

    .splash-count__reveal {
        position: absolute; inset: 0;
        display: flex; align-items: center; justify-content: center;
        opacity: 0; animation: spcntReveal 0.6s ease forwards 3s;
    }
    @@keyframes spcntReveal { to { opacity: 1; } }

    .splash-count__shockwave {
        position: absolute; top: 50%; left: 50%;
        width: 50px; height: 50px;
        border: 4px solid #d4a574;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        opacity: 0;
        animation: spcntShock 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards 3s;
    }
    @@keyframes spcntShock {
        0% { opacity: 1; transform: translate(-50%, -50%) scale(0.5); border-width: 6px; }
        100% { opacity: 0; transform: translate(-50%, -50%) scale(20); border-width: 1px; }
    }

    /* Hearts burst out with the shockwave */
    .splash-count__hearts {
        position: absolute; top: 50%; left: 50%;
        width: 0; height: 0; z-index: 6;
    }
    .splash-count__heart {
        position: absolute; top: 0; left: 0;
        color: #ff6b9d;
        font-size: 1.6rem;
        opacity: 0;
        text-shadow: 0 0 14px rgba(255,107,157,0.8);
        animation: spcntHeartBurst 2s cubic-bezier(0.16, 1, 0.3, 1) forwards 3s;
    }
    @@keyframes spcntHeartBurst {
        0% { opacity: 1; transform: rotate(var(--angle)) translateX(0) scale(0); }
        30% { opacity: 1; transform: rotate(var(--angle)) translateX(180px) scale(1.4) ; }
        100% { opacity: 0; transform: rotate(var(--angle)) translateX(50vw) scale(0.3); }
    }

    .splash-count__reveal-inner {
        text-align: center;
        opacity: 0;
        animation: spcntInnerIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards 3.3s;
    }
    @@keyframes spcntInnerIn {
        0% { opacity: 0; transform: scale(0.85); filter: blur(8px); }
        100% { opacity: 1; transform: scale(1); filter: blur(0); }
    }

    .splash-count__eyebrow {
        font-family: 'Cairo', sans-serif;
        font-size: 0.85rem; letter-spacing: 0.55em;
        color: #d4a574; font-weight: 600;
        display: block; margin-bottom: 18px;
    }
    .splash-count__title {
        font-family: 'Playfair Display', serif;
        font-style: italic; font-size: 4rem; font-weight: 700;
        background: linear-gradient(135deg, #fff 0%, #f3d69b 50%, #d4a574 100%);
        -webkit-background-clip: text; background-clip: text;
        -webkit-text-fill-color: transparent;
        line-height: 1.1;
        margin-bottom: 18px;
        text-shadow: 0 4px 30px rgba(212,165,116,0.4);
    }
    .splash-count__date {
        font-family: 'Cairo', sans-serif;
        font-size: 1rem; letter-spacing: 0.25em;
        color: rgba(255,255,255,0.7);
        display: block;
    }

    @@media (max-width: 480px) {
        .splash-count__num { font-size: 12rem; }
        .splash-count__title { font-size: 2.5rem; }
        .splash-count__eyebrow { font-size: 0.7rem; letter-spacing: 0.35em; }
    }
</style>
