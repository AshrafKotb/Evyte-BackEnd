@*
    سبلاش رومانسي بتصميم ورود متفتحة وألوان pastel.
    PartialName: BlossomReveal
*@
@model Request
@{
    var rd = Model?.RequestData;
}
<div class="splash-screen splash-blossom" id="splashScreen">
    <div class="splash-blossom__petals">
        @for (int i = 0; i < 12; i++)
        {
            <span class="splash-blossom__petal" style="--i:@i;"></span>
        }
    </div>
    <div class="splash-blossom__content">
        <div class="splash-blossom__circle">
            <div class="splash-blossom__heart">❦</div>
        </div>
        <div class="splash-blossom__line"></div>
        <div class="splash-blossom__title">You're Invited</div>
        @if (rd != null)
        {
            <div class="splash-blossom__names">@rd.GroomName &amp; @rd.BrideName</div>
        }
        <div class="splash-blossom__line"></div>
    </div>
</div>

<style>
    .splash-blossom {
        background: linear-gradient(135deg, #fce8e8 0%, #f7d6e0 50%, #e8c5d8 100%);
        overflow: hidden;
        animation: none !important;
    }
    .splash-blossom__petals {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }
    .splash-blossom__petal {
        position: absolute;
        width: 14px;
        height: 14px;
        background: radial-gradient(circle at 30% 30%, #fff 0%, #e89cc0 70%);
        border-radius: 50% 0 50% 50%;
        top: -10%;
        left: calc((var(--i) * 8.33%) + 4%);
        opacity: 0.7;
        animation: splashBlossomFall calc(6s + var(--i) * 0.4s) linear infinite;
        animation-delay: calc(var(--i) * -0.5s);
    }
    .splash-blossom__content {
        text-align: center;
        color: #8a3c5e;
        z-index: 5;
        position: relative;
        padding: 40px;
    }
    .splash-blossom__circle {
        width: 110px;
        height: 110px;
        margin: 0 auto 25px;
        background: rgba(255,255,255,0.5);
        border: 2px solid #c97aa1;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(8px);
        animation: splashBlossomCircle 2s ease-in-out infinite;
    }
    .splash-blossom__heart {
        font-size: 2.5rem;
        color: #c97aa1;
    }
    .splash-blossom__line {
        width: 80px;
        height: 1px;
        background: #c97aa1;
        margin: 18px auto;
        opacity: 0.5;
    }
    .splash-blossom__title {
        font-family: 'Playfair Display', serif;
        font-style: italic;
        font-size: 2.2rem;
        color: #8a3c5e;
    }
    .splash-blossom__names {
        font-family: 'Cairo', sans-serif;
        font-size: 1rem;
        margin-top: 8px;
        color: #a0556f;
        letter-spacing: 0.2em;
    }
    @@keyframes splashBlossomFall {
        0% { transform: translateY(0) rotate(0deg); opacity: 0; }
        10% { opacity: 0.8; }
        100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
    }
    @@keyframes splashBlossomCircle {
        0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(201,122,161,0.4); }
        50% { transform: scale(1.05); box-shadow: 0 0 0 15px rgba(201,122,161,0); }
    }
</style>
