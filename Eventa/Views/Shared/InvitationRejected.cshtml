@model Request
@{
    Layout = "~/Views/Shared/_LayoutMinimal.cshtml";
    ViewData["Title"] = "تم رفض الدعوة";
}

<h1><i class="fas fa-times-circle text-danger me-2"></i>تم رفض الدعوة</h1>
<p>نأسف لإبلاغك بأن دعوتك الخاصة بـ <strong>@Model.RequestData?.BrideName</strong> و <strong>@Model.RequestData?.GroomName</strong> قد تم رفضها.</p>
@if (!string.IsNullOrEmpty(Model?.RejectionReason))
{
    <p class="small text-warning mb-2">سبب الرفض: @Model.RejectionReason</p>
}
<p class="mb-2">يمكنك تعديل بيانات الدعوة وإعادة تقديمها أو التواصل مع الدعم من الصفحة الرئيسية.</p>