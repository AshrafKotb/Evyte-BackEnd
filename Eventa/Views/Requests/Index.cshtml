@using Eventa.Domain.Enums
@model Eventa.ApplicationCore.Models.Helper.PaginatedResult<Eventa.Domain.Entities.Request>
@{
    ViewData["Title"] = "قائمة الطلبات";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1 class="page-title">
        <i class="fa fa-list"></i> قائمة الطلبات
    </h1>
    <ol class="breadcrumb">
        <li><a href="/"><i class="fa fa-dashboard"></i> الرئيسية</a></li>
        <li class="active">قائمة الطلبات</li>
    </ol>
</section>

<section class="content">
    <div class="requests-container">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">فلترة الطلبات</h3>
                <div class="box-tools pull-left">
                    <div class="has-feedback">
                        <form asp-action="Index" method="get" class="category-search">
                            <div class="input-group">
                                <input type="text" class="form-control input-sm" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="ابحث عن طلب...">
                                <span class="input-group-btn">
                                    <button type="submit" class="btn btn-sm btn-default"><i class="fa fa-search"></i></button>
                                </span>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="box-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="requestsTable">
                        <thead>
                            <tr>
                                <th>بيانات المستخدم</th>
                                <th>تاريخ/وقت الحدث</th>
                                <th>العريس</th>
                                <th>العروس</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="user-info">
                                            <p><i class="fa fa-user"></i> <strong>@request.User.FullName</strong></p>
                                            <p><i class="fa fa-phone"></i> @request.User.PhoneNumber</p>
                                            <p><i class="fa fa-envelope"></i> @request.User.Email</p>
                                        </div>
                                    </td>
                                    <td>
                                        <i class="fa fa-calendar"></i> @request.RequestData.EventDate.ToString("yyyy-MM-dd")
                                        <br>
                                        <i class="fa fa-clock-o"></i> @request.RequestData.EventTimeFrom - @request.RequestData.EventTimeTo
                                    </td>
                                    <td>
                                        @request.RequestData.GroomName
                                        <br>
                                        <img src="@request.RequestData.GroomImageUrl" alt="Groom" class="user-thumbnail" onerror="this.src='/images/default-user.png'" />
                                    </td>
                                    <td>
                                        @request.RequestData.BrideName
                                        <br>
                                        <img src="@request.RequestData.BrideImageUrl" alt="Bride" class="user-thumbnail" onerror="this.src='/images/default-user.png'" />
                                    </td>
                                    <td>
                                        <span class="label @(request.Status == InvitationStatus.Approved ? "label-success" :
                                                          request.Status == InvitationStatus.Rejected ? "label-danger" : "label-warning")">
                                            @request.Status
                                        </span>
                                        @if (request.Status == InvitationStatus.Approved && request.ApprovedDate.HasValue)
                                        {
                                            <br />
                                            <small><i class="fa fa-calendar"></i> @request.ApprovedDate.Value.ToString("yyyy-MM-dd")</small>
                                        }
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-info btn-sm" title="التفاصيل">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@request.Id" class="btn btn-warning btn-sm" title="تعديل">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="box-footer clearfix">
                <div class="pull-left">
                    <form asp-action="Index" method="get" id="pageSizeForm">
                        <input type="hidden" name="searchTerm" value="@ViewBag.SearchTerm" />
                        <div class="form-inline">
                            <label for="pageSize" class="control-label">عرض</label>
                            <select id="pageSize" name="pageSize" class="form-control input-sm" onchange="this.form.submit()">
                                @{
                                    var pageSizes = new[] { 5, 10, 25, 50, 100 };
                                    foreach (var size in pageSizes)
                                    {
                                        if (ViewBag.PageSize == size)
                                        {
                                            <option value="@size" selected>@size</option>
                                        }
                                        else
                                        {
                                            <option value="@size">@size</option>
                                        }
                                    }
                                }
                            </select>
                            <label for="pageSize" class="control-label">عنصر في الصفحة</label>
                        </div>
                    </form>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="pull-right">
                        <ul class="pagination pagination-sm no-margin">
                            <li class="@(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a asp-action="Index"
                                   asp-route-pageNumber="@(Model.CurrentPage - 1)"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-searchTerm="@ViewBag.SearchTerm">
                                    <i class="fa fa-angle-right"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="@(i == Model.CurrentPage ? "active" : "")">
                                    <a asp-action="Index"
                                       asp-route-pageNumber="@i"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-searchTerm="@ViewBag.SearchTerm">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="@(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a asp-action="Index"
                                   asp-route-pageNumber="@(Model.CurrentPage + 1)"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-searchTerm="@ViewBag.SearchTerm">
                                    <i class="fa fa-angle-left"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/requests/index.css" />
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#requestsTable').DataTable({
                "paging": false,
                "searching": false,
                "ordering": true,
                "info": false,
                "language": {
                    "emptyTable": "لا توجد طلبات",
                    "info": "عرض _START_ إلى _END_ من _TOTAL_ طلب",
                    "infoEmpty": "عرض 0 إلى 0 من 0 طلب",
                    "lengthMenu": "عرض _MENU_ طلبات"
                }
            });
        });
    </script>
}