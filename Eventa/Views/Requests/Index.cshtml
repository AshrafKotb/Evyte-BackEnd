@using Eventa.Domain.Enums
@model Eventa.ApplicationCore.Models.Helper.PaginatedResult<Eventa.Domain.Entities.Request>
@{
    ViewData["Title"] = "قائمة الطلبات";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="page-header animate-fade-in">
    <div class="page-title">
        <h1>
            <i class="fas fa-envelope-open-text"></i>
            قائمة الطلبات
        </h1>
        <div class="page-breadcrumb">
            <a href="@Url.Action("Index", "cp")"><i class="fas fa-home"></i></a>
            <i class="fas fa-chevron-left" style="font-size: 0.7rem;"></i>
            <span>الطلبات</span>
        </div>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card animate-slide-in-up" style="margin-bottom: 24px;">
    <div class="card-body" style="padding: 20px;">
        <form asp-action="Index" method="get" class="d-flex gap-3 align-items-end flex-wrap">
            <div class="form-group" style="flex: 1; min-width: 250px; margin-bottom: 0;">
                <label class="form-label">بحث</label>
                <div style="position: relative;">
                    <input type="text" class="form-control" name="searchTerm" value="@ViewBag.SearchTerm"
                           placeholder="ابحث عن طلب (اسم العريس، العروس، البريد...)" style="padding-right: 40px;">
                    <i class="fas fa-search" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: var(--gray-400);"></i>
                </div>
            </div>
            <div class="form-group" style="min-width: 180px; margin-bottom: 0;">
                <label class="form-label">الحالة</label>
                <select name="status" class="form-control" onchange="this.form.submit()">
                    <option value="">جميع الحالات</option>
                    <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">قيد الانتظار</option>
                    <option value="Approved" selected="@(ViewBag.StatusFilter == "Approved")">تمت الموافقة</option>
                    <option value="Rejected" selected="@(ViewBag.StatusFilter == "Rejected")">مرفوض</option>
                </select>
            </div>
            <div class="form-group" style="min-width: 120px; margin-bottom: 0;">
                <label class="form-label">عدد العناصر</label>
                <select name="pageSize" class="form-control" onchange="this.form.submit()">
                    @{
                        var pageSizes = new[] { 5, 10, 25, 50, 100 };
                        foreach (var size in pageSizes)
                        {
                            <option value="@size" selected="@(ViewBag.PageSize == size)">@size</option>
                        }
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary" style="height: 48px;">
                <i class="fas fa-search"></i>
                بحث
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string) || !string.IsNullOrEmpty(ViewBag.StatusFilter as string))
            {
                <a asp-action="Index" class="btn btn-ghost" style="height: 48px;">
                    <i class="fas fa-times"></i>
                    إلغاء الفلتر
                </a>
            }
        </form>
    </div>
</div>

<!-- Stats Row -->
<div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 24px;">
    <div class="stat-card animate-slide-in-up">
        <div class="stat-icon">
            <i class="fas fa-inbox"></i>
        </div>
        <div class="stat-content">
            <h3>إجمالي الطلبات</h3>
            <div class="stat-value">@Model.TotalCount</div>
        </div>
    </div>
    <div class="stat-card amber animate-slide-in-up" style="animation-delay: 0.1s;">
        <div class="stat-icon">
            <i class="fas fa-clock"></i>
        </div>
        <div class="stat-content">
            <h3>قيد الانتظار</h3>
            <div class="stat-value">@Model.Items.Count(r => r.Status == InvitationStatus.Pending)</div>
        </div>
    </div>
    <div class="stat-card emerald animate-slide-in-up" style="animation-delay: 0.2s;">
        <div class="stat-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="stat-content">
            <h3>تمت الموافقة</h3>
            <div class="stat-value">@Model.Items.Count(r => r.Status == InvitationStatus.Approved)</div>
        </div>
    </div>
    <div class="stat-card rose animate-slide-in-up" style="animation-delay: 0.3s;">
        <div class="stat-icon">
            <i class="fas fa-times-circle"></i>
        </div>
        <div class="stat-content">
            <h3>مرفوض</h3>
            <div class="stat-value">@Model.Items.Count(r => r.Status == InvitationStatus.Rejected)</div>
        </div>
    </div>
</div>

<!-- Data Table Card -->
<div class="card animate-slide-in-up">
    <div class="card-header">
        <div class="card-title">
            <i class="fas fa-list"></i>
            <span>جميع الطلبات</span>
        </div>
        <div class="card-actions">
            <span class="badge badge-primary" style="padding: 8px 15px; border-radius: 20px;">
                @Model.TotalCount طلب
            </span>
        </div>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>بيانات المستخدم</th>
                        <th>العروسين</th>
                        <th>تاريخ الحدث</th>
                        <th>التصميم</th>
                        <th style="width: 130px;">الحالة</th>
                        <th style="width: 120px;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="fas fa-inbox"></i>
                                    <h3>لا توجد طلبات</h3>
                                    <p>لم يتم العثور على أي طلبات حتى الآن.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var request in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="user-info-cell">
                                        <div class="user-avatar-icon">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div class="user-details">
                                            <strong>@request.User?.FullName</strong>
                                            <small><i class="fas fa-phone"></i> @request.User?.PhoneNumber</small>
                                            <small><i class="fas fa-envelope"></i> @request.User?.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="couple-cell">
                                        <div class="person groom">
                                            @if (!string.IsNullOrEmpty(request.RequestData?.GroomImageUrl))
                                            {
                                                <img src="@request.RequestData.GroomImageUrl" alt="@request.RequestData.GroomName">
                                            }
                                            else
                                            {
                                                <div class="person-placeholder">
                                                    <i class="fas fa-user-tie"></i>
                                                </div>
                                            }
                                            <span>@request.RequestData?.GroomName</span>
                                        </div>
                                        <i class="fas fa-heart heart-icon"></i>
                                        <div class="person bride">
                                            @if (!string.IsNullOrEmpty(request.RequestData?.BrideImageUrl))
                                            {
                                                <img src="@request.RequestData.BrideImageUrl" alt="@request.RequestData.BrideName">
                                            }
                                            else
                                            {
                                                <div class="person-placeholder bride">
                                                    <i class="fas fa-crown"></i>
                                                </div>
                                            }
                                            <span>@request.RequestData?.BrideName</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="event-date-cell">
                                        <div class="date-main">
                                            <i class="fas fa-calendar"></i>
                                            @request.RequestData?.EventDate.ToString("yyyy/MM/dd")
                                        </div>
                                        <small>
                                            <i class="fas fa-clock"></i>
                                            @request.RequestData?.EventTimeFrom.ToString(@"hh\:mm") - @request.RequestData?.EventTimeTo.ToString(@"hh\:mm")
                                        </small>
                                        <small class="location">
                                            <i class="fas fa-map-marker-alt"></i>
                                            @request.RequestData?.EventPlaceName
                                        </small>
                                    </div>
                                </td>
                                <td>
                                    <span class="design-name">@request.Design?.NameAr</span>
                                </td>
                                <td>
                                    @switch (request.Status)
                                    {
                                        case InvitationStatus.Pending:
                                            <span class="badge badge-warning">
                                                <i class="fas fa-clock"></i> قيد الانتظار
                                            </span>
                                            break;
                                        case InvitationStatus.Approved:
                                            <span class="badge badge-success">
                                                <i class="fas fa-check"></i> مقبول
                                            </span>
                                            if (request.ApprovedDate.HasValue)
                                            {
                                                <small class="approval-date">@request.ApprovedDate.Value.ToString("yyyy/MM/dd")</small>
                                            }
                                            break;
                                        case InvitationStatus.Rejected:
                                            <span class="badge badge-danger">
                                                <i class="fas fa-times"></i> مرفوض
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-action="Details" asp-route-id="@request.Id" class="btn-table-action btn-view" title="التفاصيل">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (request.Status == InvitationStatus.Approved && !string.IsNullOrEmpty(request.WeddingSlug))
                                        {
                                            <a href="/@request.WeddingSlug" target="_blank" class="btn-table-action btn-external" title="عرض الدعوة">
                                                <i class="fas fa-external-link-alt"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="table-pagination">
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage - 1)"
                               asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-status="@ViewBag.StatusFilter">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            @if (i == 1 || i == Model.TotalPages || (i >= Model.CurrentPage - 2 && i <= Model.CurrentPage + 2))
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i"
                                       asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-status="@ViewBag.StatusFilter">
                                        @i
                                    </a>
                                </li>
                            }
                            else if (i == Model.CurrentPage - 3 || i == Model.CurrentPage + 3)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link page-ellipsis">...</span>
                                </li>
                            }
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage + 1)"
                               asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-status="@ViewBag.StatusFilter">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<style>
    /* Request-specific table styles */
    .user-info-cell {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .user-avatar-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.2) 0%, rgba(99, 102, 241, 0.1) 100%);
        border-radius: var(--radius-md);
        color: var(--primary-light);
        font-size: 1rem;
    }

    .user-details {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .user-details strong {
        color: var(--white);
        font-weight: 600;
        font-size: 0.95rem;
    }

    .user-details small {
        color: var(--gray-400);
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .user-details small i {
        color: var(--primary-light);
        font-size: 0.7rem;
    }

    /* Couple cell */
    .couple-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .person {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

    .person img {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--primary);
        transition: var(--transition-base);
    }

    .person.bride img {
        border-color: var(--accent-rose);
    }

    .person img:hover {
        transform: scale(1.1);
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }

    .person-placeholder {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(99, 102, 241, 0.2);
        color: var(--primary-light);
    }

    .person-placeholder.bride {
        background: rgba(244, 63, 94, 0.2);
        color: var(--accent-rose);
    }

    .person span {
        color: var(--gray-300);
        font-size: 0.85rem;
        text-align: center;
        max-width: 80px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .heart-icon {
        color: var(--accent-rose);
        font-size: 1rem;
        animation: pulse-heart 1.5s ease-in-out infinite;
    }

    @@keyframes pulse-heart {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.2); }
    }

    /* Event date cell */
    .event-date-cell {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .date-main {
        color: var(--white);
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .date-main i {
        color: var(--accent-gold);
    }

    .event-date-cell small {
        color: var(--gray-400);
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .event-date-cell small.location {
        color: var(--gray-500);
    }

    .event-date-cell small i {
        font-size: 0.7rem;
    }

    /* Design name */
    .design-name {
        color: var(--gray-300);
        font-weight: 500;
    }

    /* Approval date */
    .approval-date {
        display: block;
        color: var(--gray-400);
        font-size: 0.75rem;
        margin-top: 4px;
    }

    /* External link button */
    .btn-table-action.btn-external {
        background: rgba(16, 185, 129, 0.15);
        color: var(--accent-emerald);
    }

    .btn-table-action.btn-external:hover {
        background: var(--accent-emerald);
        color: var(--white);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }
</style>
