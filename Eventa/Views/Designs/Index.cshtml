@model DesignIndexVM
@{
    ViewData["Title"] = "التصميمات";
    Layout = "_Layout";
}

<!-- Page Header -->
<div class="page-header animate-fade-in">
    <div class="page-title">
        <h1>
            <i class="fas fa-palette"></i>
            التصميمات
        </h1>
        <div class="page-breadcrumb">
            <a href="@Url.Action("Index", "cp")"><i class="fas fa-home"></i></a>
            <i class="fas fa-chevron-left" style="font-size: 0.7rem;"></i>
            <span>التصميمات</span>
        </div>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-gold">
            <i class="fas fa-plus"></i>
            إضافة تصميم جديد
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card animate-slide-in-up" style="margin-bottom: 24px;">
    <div class="card-body" style="padding: 20px;">
        <form asp-action="Index" method="get" class="d-flex gap-3 align-items-end flex-wrap">
            <div class="form-group" style="flex: 1; min-width: 250px; margin-bottom: 0;">
                <label class="form-label">بحث</label>
                <div style="position: relative;">
                    <input type="text" class="form-control" name="searchTerm" value="@Model.SearchTerm"
                           placeholder="ابحث عن تصميم..." style="padding-right: 40px;">
                    <i class="fas fa-search" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: var(--gray-400);"></i>
                </div>
            </div>
            <div class="form-group" style="min-width: 150px; margin-bottom: 0;">
                <label class="form-label">عدد العناصر</label>
                <select name="pageSize" class="form-control" onchange="this.form.submit()">
                    @foreach (var option in Model.PageSizeOptions)
                    {
                        <option value="@option.Value" selected="@(Model.PageSize.ToString() == option.Value)">
                            @option.Text
                        </option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary" style="height: 48px;">
                <i class="fas fa-search"></i>
                بحث
            </button>
        </form>
    </div>
</div>

<!-- Data Table Card -->
<div class="card animate-slide-in-up">
    <div class="card-header">
        <div class="card-title">
            <i class="fas fa-list"></i>
            <span>قائمة التصميمات</span>
        </div>
        <div class="card-actions">
            <span class="badge badge-success" style="padding: 8px 15px; border-radius: 20px;">
                @Model.Designs.Count() تصميم
            </span>
        </div>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">الترتيب</th>
                        <th>التصميم</th>
                        <th style="width: 120px;">القسم</th>
                        <th style="width: 140px;">الرابط</th>
                        <th style="width: 100px;">الحالة</th>
                        <th style="width: 150px;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Designs.Any())
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="fas fa-palette"></i>
                                    <h3>لا توجد تصميمات</h3>
                                    <p>لم يتم العثور على أي تصميمات. يمكنك إضافة تصميم جديد.</p>
                                    <a asp-action="Create" class="btn btn-gold" style="margin-top: 15px;">
                                        <i class="fas fa-plus"></i>
                                        إضافة تصميم جديد
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Designs)
                        {
                            <tr class="@(item.IsDeleted ? "table-row-deleted" : "")">
                                <td>
                                    <span class="sort-badge">
                                        @item.SortingNumber
                                    </span>
                                </td>
                                <td>
                                    <div class="design-info-cell">
                                        <div class="design-icon">
                                            <i class="fas fa-paint-brush"></i>
                                        </div>
                                        <div class="design-details">
                                            <strong>@item.NameAr</strong>
                                            <small>@item.NameEn</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge badge-primary">
                                        @item.CategoryNameAr
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.WebsiteDemoUrl))
                                    {
                                        <a href="@item.WebsiteDemoUrl" target="_blank" class="btn-link-preview">
                                            <i class="fas fa-external-link-alt"></i>
                                            عرض الموقع
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="link-unavailable">
                                            <i class="fas fa-link"></i> غير متوفر
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsDeleted)
                                    {
                                        <span class="badge badge-danger">
                                            <i class="fas fa-trash"></i> محذوف
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">
                                            <i class="fas fa-check"></i> متاح
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        @if (!item.IsDeleted)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-table-action btn-edit" title="تعديل">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-table-action btn-view" title="التفاصيل">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        }
                                        <button type="button" class="btn-table-action @(item.IsDeleted ? "btn-restore" : "btn-delete") btn-action"
                                                data-id="@item.Id"
                                                data-action="@(item.IsDeleted ? "restore" : "delete")"
                                                title="@(item.IsDeleted ? "استعادة" : "حذف")">
                                            <i class="@(item.IsDeleted ? "fas fa-undo" : "fas fa-trash-alt")"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="table-pagination">
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Model.SearchTerm">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            @if (i == 1 || i == Model.TotalPages || (i >= Model.CurrentPage - 2 && i <= Model.CurrentPage + 2))
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i"
                                       asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Model.SearchTerm">
                                        @i
                                    </a>
                                </li>
                            }
                            else if (i == Model.CurrentPage - 3 || i == Model.CurrentPage + 3)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link page-ellipsis">...</span>
                                </li>
                            }
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Model.SearchTerm">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<style>
    /* Design-specific table styles */
    .design-info-cell {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .design-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--primary) 0%, #764ba2 100%);
        border-radius: var(--radius-md);
        color: var(--white);
        font-size: 1.1rem;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }

    .design-details {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .design-details strong {
        color: var(--white);
        font-weight: 600;
        font-size: 0.95rem;
    }

    .design-details small {
        color: var(--gray-400);
        font-size: 0.85rem;
    }

    .btn-link-preview {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        background: rgba(16, 185, 129, 0.15);
        color: var(--accent-emerald);
        border-radius: var(--radius-md);
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        transition: var(--transition-base);
    }

    .btn-link-preview:hover {
        background: var(--accent-emerald);
        color: var(--white);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .link-unavailable {
        color: var(--gray-400);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .link-unavailable i {
        opacity: 0.5;
    }
</style>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-action').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.dataset.id;
                const action = this.dataset.action;
                const isDelete = action === 'delete';

                Swal.fire({
                    title: isDelete ? 'حذف التصميم' : 'استعادة التصميم',
                    text: isDelete ? 'هل أنت متأكد من حذف هذا التصميم؟' : 'هل أنت متأكد من استعادة هذا التصميم؟',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: isDelete ? '#f43f5e' : '#10b981',
                    cancelButtonColor: '#6366f1',
                    confirmButtonText: isDelete ? 'نعم، احذف' : 'نعم، استعد',
                    cancelButtonText: 'إلغاء',
                    background: '#1a1a2e',
                    color: '#fff',
                    customClass: {
                        popup: 'swal-modern-popup',
                        title: 'swal-modern-title',
                        confirmButton: 'swal-modern-confirm',
                        cancelButton: 'swal-modern-cancel'
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = isDelete ? '@Url.Action("Delete", "Designs")' : '@Url.Action("Restore", "Designs")';

                        const tokenInput = document.createElement('input');
                        tokenInput.type = 'hidden';
                        tokenInput.name = '__RequestVerificationToken';
                        tokenInput.value = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];
                        form.appendChild(tokenInput);

                        const idInput = document.createElement('input');
                        idInput.type = 'hidden';
                        idInput.name = 'id';
                        idInput.value = id;
                        form.appendChild(idInput);

                        document.body.appendChild(form);
                        form.submit();
                    }
                });
            });
        });
    </script>
}
