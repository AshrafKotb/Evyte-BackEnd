@model DesignVM
@{
    ViewData["Title"] = "تفاصيل التصميم";
    Layout = "_Layout";
}

<!-- Page Header -->
<div class="page-header animate-fade-in">
    <div class="page-title">
        <h1>
            <i class="fas fa-palette"></i>
            تفاصيل التصميم
        </h1>
        <div class="page-breadcrumb">
            <a href="@Url.Action("Index", "cp")"><i class="fas fa-home"></i></a>
            <i class="fas fa-chevron-left" style="font-size: 0.7rem;"></i>
            <a href="@Url.Action("Index", "Designs")">التصاميم</a>
            <i class="fas fa-chevron-left" style="font-size: 0.7rem;"></i>
            <span>تفاصيل</span>
        </div>
    </div>
    <div class="page-actions">
        @if (!Model.IsDeleted)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="fas fa-edit"></i>
                تعديل
            </a>
        }
        <a asp-action="Index" class="btn btn-ghost">
            <i class="fas fa-arrow-right"></i>
            رجوع للقائمة
        </a>
    </div>
</div>

<!-- Details Card -->
<div class="card animate-slide-in-up">
    <div class="card-body" style="padding: 0;">
        <div class="details-layout">
            <!-- Design Icon Section -->
            <div class="details-image-section">
                <div class="details-icon-wrapper">
                    <i class="fas fa-palette"></i>
                </div>

                <!-- Status Badge -->
                <div class="details-status">
                    @if (Model.IsDeleted)
                    {
                        <span class="badge badge-danger badge-lg">
                            <i class="fas fa-trash"></i>
                            محذوف
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-success badge-lg">
                            <i class="fas fa-check-circle"></i>
                            متاح
                        </span>
                    }
                </div>

                <!-- Demo Link -->
                @if (!string.IsNullOrEmpty(Model.WebsiteDemoUrl))
                {
                    <a href="@Model.WebsiteDemoUrl" target="_blank" class="demo-link-btn">
                        <i class="fas fa-external-link-alt"></i>
                        معاينة التصميم
                    </a>
                }
            </div>

            <!-- Info Section -->
            <div class="details-info-section">
                <!-- Design Name -->
                <div class="details-header">
                    <h2 class="details-title">@Model.NameAr</h2>
                    <p class="details-subtitle">@Model.NameEn</p>
                </div>

                <!-- Info Items -->
                <div class="details-grid">
                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="fas fa-folder"></i>
                        </div>
                        <div class="detail-content">
                            <span class="detail-label">القسم</span>
                            <span class="detail-value">@Model.CategoryNameAr</span>
                            <small class="detail-subtitle">@Model.CategoryNameEn</small>
                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="fas fa-sort-numeric-up-alt"></i>
                        </div>
                        <div class="detail-content">
                            <span class="detail-label">ترتيب العرض</span>
                            <span class="detail-value">@Model.SortingNumber</span>
                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <div class="detail-content">
                            <span class="detail-label">تاريخ الإنشاء</span>
                            <span class="detail-value">@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</span>
                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-icon demo-icon">
                            <i class="fas fa-link"></i>
                        </div>
                        <div class="detail-content">
                            <span class="detail-label">رابط العرض</span>
                            @if (!string.IsNullOrEmpty(Model.WebsiteDemoUrl))
                            {
                                <a href="@Model.WebsiteDemoUrl" target="_blank" class="detail-link">
                                    <i class="fas fa-external-link-alt"></i>
                                    زيارة الرابط
                                </a>
                            }
                            else
                            {
                                <span class="detail-value text-muted">لا يوجد رابط</span>
                            }
                        </div>
                    </div>

                    <div class="detail-item full-width">
                        <div class="detail-icon">
                            <i class="fas fa-file-alt"></i>
                        </div>
                        <div class="detail-content">
                            <span class="detail-label">الوصف بالعربية</span>
                            <div class="detail-description">
                                @(string.IsNullOrEmpty(Model.DescriptionAr) ? "لا يوجد وصف" : Model.DescriptionAr)
                            </div>
                        </div>
                    </div>

                    <div class="detail-item full-width">
                        <div class="detail-icon">
                            <i class="fas fa-file-alt"></i>
                        </div>
                        <div class="detail-content">
                            <span class="detail-label">الوصف بالإنجليزية</span>
                            <div class="detail-description">
                                @(string.IsNullOrEmpty(Model.DescriptionEn) ? "No description" : Model.DescriptionEn)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Details Page Styles */
    .details-layout {
        display: grid;
        grid-template-columns: 350px 1fr;
        gap: 0;
        min-height: 500px;
    }

    .details-image-section {
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(212, 165, 116, 0.1) 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px;
        position: relative;
        border-left: 1px solid var(--border-color);
    }

    .details-image-wrapper {
        width: 220px;
        height: 220px;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid var(--accent-gold);
        box-shadow: 0 8px 32px rgba(212, 165, 116, 0.3);
        transition: var(--transition-base);
    }

    .details-image-wrapper.design-image {
        border-radius: var(--radius-lg);
        width: 260px;
        height: 180px;
    }

    .details-image-wrapper:hover {
        transform: scale(1.05);
        box-shadow: 0 12px 40px rgba(212, 165, 116, 0.4);
    }

    .details-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .details-image-placeholder {
        width: 220px;
        height: 180px;
        border-radius: var(--radius-lg);
        background: var(--glass-bg);
        border: 4px dashed var(--border-color);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        color: var(--gray-400);
    }

    .details-image-placeholder i {
        font-size: 3rem;
    }

    .details-icon-wrapper {
        width: 160px;
        height: 160px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(212, 165, 116, 0.2) 0%, rgba(212, 165, 116, 0.1) 100%);
        border: 4px solid var(--accent-gold);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 32px rgba(212, 165, 116, 0.3);
        transition: var(--transition-base);
    }

    .details-icon-wrapper i {
        font-size: 4rem;
        color: var(--accent-gold);
    }

    .details-icon-wrapper:hover {
        transform: scale(1.05);
        box-shadow: 0 12px 40px rgba(212, 165, 116, 0.4);
    }

    .details-status {
        margin-top: 24px;
    }

    .badge-lg {
        padding: 12px 24px;
        font-size: 1rem;
        border-radius: var(--radius-full);
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .demo-link-btn {
        margin-top: 20px;
        padding: 12px 24px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: var(--radius-full);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: var(--transition-base);
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    }

    .demo-link-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
        color: white;
    }

    .details-info-section {
        padding: 40px;
    }

    .details-header {
        margin-bottom: 32px;
        padding-bottom: 24px;
        border-bottom: 2px solid var(--border-color);
    }

    .details-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--white);
        margin-bottom: 8px;
        background: var(--gradient-gold);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .details-subtitle {
        font-size: 1.2rem;
        color: var(--gray-400);
        font-style: italic;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }

    .detail-item {
        display: flex;
        gap: 16px;
        padding: 20px;
        background: var(--glass-bg);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        transition: var(--transition-base);
    }

    .detail-item:hover {
        background: var(--bg-hover);
        border-color: var(--primary);
        transform: translateY(-2px);
    }

    .detail-item.full-width {
        grid-column: span 2;
    }

    .detail-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        background: linear-gradient(135deg, var(--primary) 0%, #764ba2 100%);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.1rem;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }

    .detail-icon.demo-icon {
        background: linear-gradient(135deg, var(--accent-gold) 0%, #c4956e 100%);
        box-shadow: 0 4px 12px rgba(212, 165, 116, 0.3);
    }

    .detail-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .detail-label {
        font-size: 0.85rem;
        color: var(--gray-400);
        font-weight: 500;
    }

    .detail-value {
        font-size: 1.1rem;
        color: var(--white);
        font-weight: 600;
    }

    .detail-subtitle {
        font-size: 0.9rem;
        color: var(--gray-400);
    }

    .detail-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: rgba(99, 102, 241, 0.15);
        color: var(--primary-light);
        border-radius: var(--radius-md);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.95rem;
        transition: var(--transition-base);
        width: fit-content;
    }

    .detail-link:hover {
        background: var(--primary);
        color: white;
        transform: translateX(-5px);
    }

    .detail-description {
        font-size: 1rem;
        color: var(--text-secondary);
        line-height: 1.7;
        padding: 12px 16px;
        background: rgba(0, 0, 0, 0.2);
        border-radius: var(--radius-md);
        max-height: 120px;
        overflow-y: auto;
    }

    .text-muted {
        color: var(--gray-400) !important;
        font-style: italic;
    }

    /* Light Mode */
    [data-theme="light"] .details-title {
        -webkit-text-fill-color: initial;
        color: var(--text-primary);
        background: none;
    }

    [data-theme="light"] .details-subtitle {
        color: var(--text-muted);
    }

    [data-theme="light"] .detail-value {
        color: var(--text-primary);
    }

    [data-theme="light"] .detail-description {
        background: rgba(0, 0, 0, 0.03);
        color: var(--text-secondary);
    }

    [data-theme="light"] .details-image-section {
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(212, 165, 116, 0.05) 100%);
        border-left-color: var(--border-color);
    }

    [data-theme="light"] .detail-link {
        background: rgba(99, 102, 241, 0.1);
    }

    [data-theme="light"] .demo-link-btn {
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.2);
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .details-layout {
            grid-template-columns: 1fr;
        }

        .details-image-section {
            border-left: none;
            border-bottom: 1px solid var(--border-color);
            padding: 30px;
        }

        .details-image-wrapper,
        .details-image-placeholder {
            width: 200px;
            height: 140px;
        }

        .details-info-section {
            padding: 30px;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .detail-item.full-width {
            grid-column: span 1;
        }
    }

    @@media (max-width: 576px) {
        .details-image-wrapper,
        .details-image-placeholder {
            width: 180px;
            height: 120px;
        }

        .details-title {
            font-size: 1.5rem;
        }

        .details-info-section {
            padding: 20px;
        }

        .detail-item {
            padding: 16px;
        }

        .demo-link-btn {
            padding: 10px 20px;
            font-size: 0.9rem;
        }
    }
</style>
