@{
    ViewData["Title"] = "إضافة سبلاش جديد";
    ViewData["Dir"] = "rtl";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/forms.css" />

<form asp-action="Create" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>

    <div class="form-card">
        <div class="form-header">
            <h1>@ViewData["Title"]</h1>
            <p class="text-muted">سجّل سبلاش جديد في المكتبة وحدد ملف الـ Partial المرتبط به</p>
        </div>

        <div class="form-group mb-4">
            <label class="form-label">الاسم بالعربي <span class="text-danger">*</span></label>
            <div class="input-group-icon">
                <i class="fas fa-tag"></i>
                <input name="nameAr" class="form-control text-end" placeholder="مثال: مظروف ذهبي" required>
            </div>
        </div>

        <div class="form-group mb-4">
            <label class="form-label">الاسم بالإنجليزي <span class="text-danger">*</span></label>
            <div class="input-group-icon">
                <i class="fas fa-tag"></i>
                <input name="nameEn" class="form-control" placeholder="e.g. Golden Envelope" required>
            </div>
        </div>

        <div class="form-group mb-4">
            <label class="form-label">اسم ملف الـ Partial <span class="text-danger">*</span></label>
            <div class="input-group-icon">
                <i class="fas fa-file-code"></i>
                <input name="partialName" class="form-control" placeholder="EnvelopeOpen" required>
            </div>
            <small class="form-text text-muted">
                لا تكتب الـ underscore أو الامتداد. مثلاً اكتب <code>EnvelopeOpen</code> وهيتم تحميل
                <code>~/Views/Shared/splashes/_EnvelopeOpen.cshtml</code>
            </small>
        </div>

        <div class="form-group mb-4">
            <label class="form-label">الوصف بالعربي</label>
            <div class="input-group-icon">
                <i class="fas fa-align-right"></i>
                <textarea name="descriptionAr" class="form-control text-end" placeholder="وصف مختصر للسبلاش" rows="2"></textarea>
            </div>
        </div>

        <div class="form-group mb-4">
            <label class="form-label">الوصف بالإنجليزي</label>
            <div class="input-group-icon">
                <i class="fas fa-align-left"></i>
                <textarea name="descriptionEn" class="form-control" placeholder="Short description" rows="2"></textarea>
            </div>
        </div>

        <div class="form-group mb-4">
            <label class="form-label">صورة المعاينة (Thumbnail)</label>
            <div class="image-upload-container">
                <div class="mb-3">
                    <i class="fas fa-cloud-upload-alt fa-2x text-muted mb-3"></i>
                    <p class="mb-2">صورة معاينة للسبلاش يشوفها الأدمن والعميل</p>
                    <input type="file" name="thumbnailFile" class="form-control-file" accept="image/*" id="thumbUpload">
                    <label for="thumbUpload" class="btn btn-outline-primary mt-2">
                        <i class="fas fa-folder-open"></i> اختر صورة
                    </label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group mb-4">
                    <label class="form-label">مدة العرض (بالميلي ثانية)</label>
                    <div class="input-group-icon">
                        <i class="fas fa-clock"></i>
                        <input type="number" name="durationMs" class="form-control" value="3000" min="500" max="20000">
                    </div>
                    <small class="form-text text-muted">المدة قبل الإخفاء التلقائي. تتجاهل لو السبلاش بتفاعل.</small>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group mb-4">
                    <label class="form-label">ترتيب العرض</label>
                    <div class="input-group-icon">
                        <i class="fas fa-sort-numeric-down"></i>
                        <input type="number" name="sortingNumber" class="form-control" value="0">
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group mb-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="requiresInteraction" value="true" id="reqInt">
                <label class="form-check-label" for="reqInt">
                    يحتاج تفاعل من المستخدم (Tap to open) — مش بيختفي تلقائياً
                </label>
            </div>
        </div>

        <div class="form-group mb-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="isAct" checked>
                <label class="form-check-label" for="isAct">
                    مُفعّل (ظاهر للعملاء)
                </label>
            </div>
        </div>

        <div class="form-group mb-4">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="isDefault" value="true" id="isDef">
                <label class="form-check-label" for="isDef">
                    تعيين كافتراضي (وسيتم إلغاء الافتراضي عن أي سبلاش آخر)
                </label>
            </div>
        </div>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-submit text-white">
            <i class="fas fa-save me-2"></i>إضافة
        </button>
        <a asp-action="Index" class="btn btn-secondary">رجوع إلى القائمة</a>
    </div>
</form>
