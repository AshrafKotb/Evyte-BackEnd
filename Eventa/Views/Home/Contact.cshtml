@using Microsoft.AspNetCore.Localization
@model GeneralInformation
@{
    ViewData["Title"] = "Contact";
    Layout = "_WebsiteLayout";
    var isEnglish = Context.Request.Cookies[CookieRequestCultureProvider.DefaultCookieName]?.Split('|')[0]?.Split('=')[1] == "en";
}

<!-- start wpo-page-title -->
<section class="wpo-page-title">
    <div class="container">
        <div class="row">
            <div class="col col-xs-12">
                <div class="wpo-breadcumb-wrap">
                    <h2>@(isEnglish ? "Contact Us" : "اتصل بنا")</h2>
                    <ol class="wpo-breadcumb-wrap">
                        <li><a asp-action="index" asp-controller="home">@(isEnglish ? "Home" : "الرئيسية")</a></li>
                        <li>@(isEnglish ? "Contact" : "اتصل بنا")</li>
                    </ol>
                </div>
            </div>
        </div> <!-- end row -->
    </div> <!-- end container -->
</section>
<!-- end page-title -->
<!-- start wpo-contact-pg-section -->
<section class="wpo-contact-pg-section section-padding" style="padding-bottom: 50px !important;">
    <div class="container">
        <div class="row">
            <div class="col col-lg-10 offset-lg-1">
                <div class="office-info">
                    <div class="row">
                        <div class="col col-xl-4 col-lg-6 col-md-6 col-12">
                            <div class="office-info-item">
                                <div class="office-info-icon">
                                    <div class="icon">
                                        <i class="fi flaticon-maps-and-flags"></i>
                                    </div>
                                </div>
                                <div class="office-info-text">
                                    <h2>@(isEnglish ? "Address" : "العنوان")</h2>
                                    <p>@(isEnglish ? Model.AddressEn : Model.AddressAr)</p>
                                </div>
                            </div>
                        </div>
                        <div class="col col-xl-4 col-lg-6 col-md-6 col-12">
                            <div class="office-info-item">
                                <div class="office-info-icon">
                                    <div class="icon">
                                        <i class="fi flaticon-email"></i>
                                    </div>
                                </div>
                                <div class="office-info-text">
                                    <h2>@(isEnglish ? "Email Us" : "البريد الإلكتروني")</h2>
                                    <p>@Model.Email</p>
                                    @if (!string.IsNullOrWhiteSpace(Model.Email2))
                                    {
                                        <p>@Model.Email2</p>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col col-xl-4 col-lg-6 col-md-6 col-12">
                            <div class="office-info-item">
                                <div class="office-info-icon">
                                    <div class="icon">
                                        <i class="fi flaticon-phone-call"></i>
                                    </div>
                                </div>
                                <div class="office-info-text">
                                    <h2>@(isEnglish ? "Call Now" : "اتصل الآن")</h2>
                                    <p>+2 @Model.PhoneNumber</p>
                                    @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber2))
                                    {
                                        <p>+2 @Model.PhoneNumber2</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Social Media Card -->
                <div class="social-media-card" style="background: #f9f9f9; padding: 30px; border-radius: 10px; margin-bottom: 40px; text-align: center;">
                    <h2 style="margin-bottom: 20px;">@(isEnglish ? "Follow Us On Social Media" : "تابعنا على وسائل التواصل الاجتماعي")</h2>
                    <div class="social-icons" style="display: flex; justify-content: center; gap: 20px;">
                        <a href="#" style="color: #3b5998; font-size: 24px;" title="Facebook"><i class="fab fa-facebook"></i></a>
                        <a href="#" style="color: #E1306C; font-size: 24px;" title="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" style="color: #FF0000; font-size: 24px;" title="YouTube"><i class="fab fa-youtube"></i></a>
                        <a href="#" style="color: #000000; font-size: 24px;" title="TikTok"><i class="fab fa-tiktok"></i></a>
                        <a href="#" style="color: #FFFC00; font-size: 24px;" title="Snapchat"><i class="fab fa-snapchat"></i></a>
                    </div>
                </div>
                <!-- End Social Media Card -->

                <div class="wpo-contact-title">
                    <h2>@(isEnglish ? "Need help? We're always here!" : "تحتاج مساعدة؟ نحن هنا دائماً!")</h2>
                    <p>
                        @(isEnglish ?
                            "If you have any questions, suggestions, or need help designing your invitation, send us a message and our team will respond to you as soon as possible." :
                            "إذا كان لديك أي استفسارات، اقتراحات، أو تحتاج مساعدة في تصميم دعوتك، أرسل لنا رسالة وسيقوم فريقنا بالرد عليك في أقرب وقت ممكن.")
                    </p>
                </div>
                <div class="wpo-contact-form-area">
                    <form method="post" class="contact-validation-active" id="contact-form-main">
                        <div>
                            <input type="text" class="form-control" name="name" id="name"
                                   placeholder="@(isEnglish ? "Your Name*" : "اسمك*")">
                        </div>
                        <div>
                            <input type="email" class="form-control" name="email" id="email"
                                   placeholder="@(isEnglish ? "Your Email*" : "بريدك الإلكتروني*")">
                        </div>
                        <div>
                            <input type="tel" class="form-control" name="Phone" id="Phone"
                                   placeholder="@(isEnglish ? "Phone Number" : "رقم الهاتف")">
                        </div>
                        <div>
                            <select name="service" class="form-control">
                                <option disabled="disabled" selected="">@(isEnglish ? "Event Type" : "نوع المناسبة")</option>
                            </select>
                        </div>
                        <div class="fullwidth">
                            <textarea class="form-control" name="note" id="note"
                                      placeholder="@(isEnglish ? "Message..." : "رسالتك...")"></textarea>
                        </div>
                        <div class="submit-area">
                            <button type="submit" class="theme-btn-s4">@(isEnglish ? "Get in Touch" : "تواصل معنا")</button>
                            <div id="loader">
                                <i class="ti-reload"></i>
                            </div>
                        </div>
                        <div class="clearfix error-handling-messages">
                            <div id="success">@(isEnglish ? "Thank you" : "شكراً لك")</div>
                            <div id="error"> @(isEnglish ? "Error occurred while sending email. Please try again later." : "حدث خطأ أثناء إرسال البريد الإلكتروني. يرجى المحاولة مرة أخرى لاحقاً.") </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- end container -->
</section>
<!-- end wpo-contact-pg-section -->
<!-- start wpo-about-section -->
<section class="wpo-about-section section-padding " style="padding-bottom: 50px !important;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-8 col-md-10 col-12">
                <div class="wpo-section-title">
                    <h2>
                        @(isEnglish ? "Got a complaint?" : "لديك شكوى؟")
                    </h2>
                </div>
            </div>
        </div>
        <div class="wpo-about-wrap">
            <div class="row align-items-center">
                <div class="col-xl-11 offset-xl-1 col-lg-12 col-md-12 col-12">
                    <div class="wpo-about-text wow fadeInLeftSlow" style="max-width: 100% !important;" data-wow-duration="1000ms">
                        <p>
                            @(isEnglish ?
                                "If you encounter any issues with payment, design, or receiving your invitation, we're here to resolve them immediately. Send us the details at: 📩 complaints@evyte.com -- or contact us directly on WhatsApp." :
                                "إذا واجهت أي مشاكل مع الدفع، التصميم، أو استلام دعوتك، نحن هنا لحلها فوراً. أرسل لنا التفاصيل على: 📩 complaints@evyte.com -- أو تواصل معنا مباشرة على واتساب.")
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- end container -->
</section>
<!-- end Service-section -->
<!-- start wpo-about-section -->
<section class="wpo-about-section " style="padding-bottom: 50px !important;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-8 col-md-10 col-12">
                <div class="wpo-section-title">
                    <h2>
                        @(isEnglish ? "Interested in collaborating with us?" : "مهتم بالتعاون معنا؟")
                    </h2>
                </div>
            </div>
        </div>
        <div class="wpo-about-wrap">
            <div class="row align-items-center">
                <div class="col-xl-11 offset-xl-1 col-lg-12 col-md-12 col-12">
                    <div class="wpo-about-text wow fadeInLeftSlow" style="max-width: 100% !important;" data-wow-duration="1000ms">
                        <p>
                            @(isEnglish ?
                                "If you're a designer, blogger, influencer, or even a wedding planner, we'd love to hear from you and collaborate! Email us at: 📩 partners@evyte.com Or send us a message using the form and indicate your interest in collaborating." :
                                "إذا كنت مصمماً، مدوناً، مؤثراً، أو حتى مخطط حفلات زفاف، نحن نود أن نسمع منك ونعمل معاً! راسلنا على: 📩 partners@evyte.com أو أرسل لنا رسالة باستخدام النموذج واذكر رغبتك في التعاون.")
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- end container -->
</section>
<!-- end Service-section -->
<!-- start wpo-contact-map -->
<section class="wpo-contact-map-section">
    <h2 class="hidden">Contact map</h2>
    <div class="wpo-contact-map">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d110502.60389525099!2d31.18842339514691!3d30.04441964436605!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14583fa60b21beeb%3A0x79dfb296e8423bba!2sCairo%2C%20Cairo%20Governorate%2C%20Egypt!5e0!3m2!1sen!2seg!4v1620000000000!5m2!1sen!2seg"
                allowfullscreen loading="lazy"></iframe>
    </div>
</section>
<!-- end wpo-contact-map -->