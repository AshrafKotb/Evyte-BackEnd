@using Microsoft.AspNetCore.Localization
@{
    ViewData["Title"] = "About";
    Layout = "_WebsiteLayout";
    var isEnglish = Context.Request.Cookies[CookieRequestCultureProvider.DefaultCookieName]?.Split('|')[0]?.Split('=')[1] == "en";
}

<!-- start wpo-page-title -->
<section class="wpo-page-title">
    <div class="container">
        <div class="row">
            <div class="col col-xs-12">
                <div class="wpo-breadcumb-wrap">
                    <h2>@(isEnglish ? "About Us" : "من نحن")</h2>
                    <ol class="wpo-breadcumb-wrap">
                        <li><a asp-action="index" asp-controller="home">@(isEnglish ? "Home" : "الرئيسية")</a></li>
                        <li>@(isEnglish ? "About" : "من نحن")</li>
                    </ol>
                </div>
            </div>
        </div> <!-- end row -->
    </div> <!-- end container -->
</section>
<!-- end page-title -->
<!-- start wpo-about-section -->
<section class="wpo-about-section section-padding" style="padding-bottom: 50px !important;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-8 col-md-10 col-12">
                <div class="wpo-section-title">
                    <span>@(isEnglish ? "Who we are? Why Eventa?" : "من نحن؟ ولماذا إيفينتا؟")</span>
                    <h2>@(isEnglish ? "We are The World Best Wedding Agency" : "نحن أفضل وكالة دعوات لحفلات الزفاف")</h2>
                </div>
            </div>
        </div>
        <div class="wpo-about-wrap">
            <div class="row align-items-center">
                <div class="col-xl-11 offset-xl-1 col-lg-12 col-md-12 col-12">
                    <div class="wpo-about-text wow fadeInLeftSlow" style="max-width: 100% !important;" data-wow-duration="1000ms">
                        <p>
                            @if (isEnglish)
                            {
                                <small>W</small>
                                <text>
                                    e are simply a group of youth who believe that every occasion deserves to be special from the very first detail, even the invitation.
                                    That's why we created Eventa so you can send invitations to your wedding, engagement, or any other event in an easy, chic way, without the headache of printing and distribution.
                                </text>
                            }
                            else
                            {
                                <small>نحن</small>
                                <text>
                                    ببساطة مجموعة من الشباب الذين يؤمنون بأن كل مناسبة تستحق أن تكون مميزة من أصغر التفاصيل، حتى الدعوة.
                                    لهذا أنشأنا إيفينتا لتتمكن من إرسال دعوات لحفل زفافك، خطوبتك، أو أي حدث آخر بطريقة سهلة وعصرية، دون عناء الطباعة والتوزيع.
                                </text>
                            }
                        </p>
                        <p>
                            @(isEnglish ?
                                "At Eventa, we provide ready-made designs that you can customize yourself, and you can send the invitation via a single link on WhatsApp, Messenger, or even a QR code. All of this can be done in less than 5 minutes." :
                                "في إيفينتا، نوفر تصاميم جاهزة يمكنك تخصيصها بنفسك، ويمكنك إرسال الدعوة عبر رابط واحد على واتساب، ماسنجر، أو حتى كود QR. كل هذا يمكن إنجازه في أقل من 5 دقائق.")
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div> <!-- end container -->
</section>
<!-- end Service-section -->
<!-- start wpo-about-section -->
<section class="wpo-about-section " style="padding-bottom: 50px !important;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-8 col-md-10 col-12">
                <div class="wpo-section-title">
                    <h2>
                        @(isEnglish ? "Our vision" : "رؤيتنا")
                    </h2>
                </div>
            </div>
        </div>
        <div class="wpo-about-wrap">
            <div class="row align-items-center">
                <div class="col-xl-11 offset-xl-1 col-lg-12 col-md-12 col-12">
                    <div class="wpo-about-text wow fadeInLeftSlow" style="max-width: 100% !important;" data-wow-duration="1000ms">
                        <p>
                            @if (isEnglish)
                            {
                                <small>T</small>
                                <text>o make every invitation in Egypt digital, elegant, easy to use, and deliver it to each guest in a unique way</text>
                            }
                            else
                            {
                                <small>أن</small>
                                <text>نجعل كل دعوة في مصر رقمية، أنيقة، سهلة الاستخدام، ونوصلها لكل ضيف بطريقة فريدة</text>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div> <!-- end container -->
</section>
<!-- end Service-section -->
<!-- start wpo-fun-fact-section -->
<section class="wpo-fun-fact-section section-padding pt-0">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col col-lg-6">
                <div class="preview-section-title">
                    <i><img src="~/assets/images/preview/title-1.png" alt=""></i>
                    <h2>@(isEnglish ? "Why Eventa ?" : "لماذا إيفينتا؟")</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col col-xs-12">
                <div class="wpo-fun-fact-grids clearfix">
                    <div class="grid">
                        <div class="info">
                            <div class="flower"><img src="~/assets/images/funfact/1.svg" alt=""></div>
                            <h3><span class="odometer" data-count="3">00</span></h3>
                            <p>@(isEnglish ? "Your Invitation is ready within only 3 minutes" : "تصبح دعوتك جاهزة خلال 3 دقائق فقط")</p>
                        </div>
                    </div>
                    <div class="grid">
                        <div class="info">
                            <div class="flower"><img src="~/assets/images/funfact/2.svg" alt=""></div>
                            <h3><span class="odometer" data-count="6">00</span></h3>
                            <p>@(isEnglish ? "More than 6 different designs to match your desire" : "أكثر من 6 تصاميم مختلفة تناسب ذوقك")</p>
                        </div>
                    </div>
                    <div class="grid">
                        <div class="info">
                            <div class="flower"><img src="~/assets/images/funfact/3.svg" alt=""></div>
                            <h3><span class="odometer" data-count="5">00</span></h3>
                            <p>@(isEnglish ? "Can be used with more than 5 types of events" : "يمكن استخدامها لأكثر من 5 أنواع من الأحداث")</p>
                        </div>
                    </div>
                    <div class="grid">
                        <div class="info">
                            <div class="flower"><img src="~/assets/images/funfact/4.svg" alt=""></div>
                            <h3><span class="odometer" data-count="24">00</span></h3>
                            <p>@(isEnglish ? "We're here to support you 24 hours" : "نحن هنا لدعمك على مدار 24 ساعة")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end wpo-fun-fact-section -->
<!--Start wpo-testimonial-section-->
<section class="wpo-testimonial-section-s2">
    <div class="container">
        <div class="wpo-testimonial-wrap">
            <div class="row">
                <div class="col col-lg-12">
                    <div class="wpo-testimonial-items">
                        <div class="wpo-section-title">
                            <span>@(isEnglish ? "Testimonials" : "آراء العملاء")</span>
                            <h2>@(isEnglish ? "What Our Client Says" : "ما يقوله عملاؤنا")</h2>
                        </div>
                        <div class="wpo-testimonial-active">
                            <div class="wpo-testimonial-item">
                                <div class="wpo-testimonial-text">
                                    <p>
                                        @(isEnglish ?
                                            "Eventa made our wedding invitations absolutely stunning! The digital design was elegant and modern, and our guests couldn't stop complimenting how unique and easy to use it was. The whole process took less than 10 minutes - simply amazing service!" :
                                            "جعلت إيفينتا دعوات زفافنا رائعة الجمال! كان التصميم الرقمي أنيقًا وعصريًا، ولم يتوقف ضيوفنا عن الإشادة بمدى تفرده وسهولة استخدامه. استغرق العملية بأكملها أقل من 10 دقائق - خدمة مذهلة ببساطة!")
                                    </p>
                                    <div class="wpo-testimonial-text-btm">
                                        <div class="tsm-img">
                                            <img style="height: 75px;width: 95px;" src="~/assets/images/first.png" alt="">
                                        </div>
                                        <h3>@(isEnglish ? "Sarah & Mohamed" : "سارة ومحمد")</h3>
                                        <span>@(isEnglish ? "Wedding - June 2023" : "زفاف - يونيو ٢٠٢٣")</span>
                                    </div>
                                </div>
                            </div>
                            <div class="wpo-testimonial-item">
                                <div class="wpo-testimonial-text">
                                    <p>
                                        @(isEnglish ?
                                            "As an event planner, I highly recommend Eventa for all my clients. Their digital invitations save time and money while maintaining exceptional quality. The customization options are fantastic, and the support team is always responsive and helpful." :
                                            "كمخطط فعاليات، أوصي بشدة بإيفينتا لجميع عملائي. دعواتهم الرقمية توفر الوقت والمال مع الحفاظ على جودة استثنائية. خيارات التخصيص رائعة، وفريق الدعم دائمًا ما يكون سريع الاستجابة ومفيدًا.")
                                    </p>
                                    <div class="wpo-testimonial-text-btm">
                                        <div class="tsm-img">
                                            <img style="height: 75px;width: 95px;" src="~/assets/images/second.png" alt="">
                                        </div>
                                        <h3>@(isEnglish ? "Nadia - Event Planner" : "نادية - مخطط فعاليات")</h3>
                                        <span>@(isEnglish ? "Professional User" : "مستخدم محترف")</span>
                                    </div>
                                </div>
                            </div>
                            <div class="wpo-testimonial-item">
                                <div class="wpo-testimonial-text">
                                    <p>
                                        @(isEnglish ?
                                            "We were hesitant about digital invitations at first, but Eventa changed our minds completely! The design was more beautiful than traditional paper cards, and tracking RSVPs was incredibly easy. Plus, it's eco-friendly - a perfect choice for modern couples!" :
                                            "كنا مترددين بشأن الدعوات الرقمية في البداية، لكن إيفينتا غيرت رأينا تمامًا! كان التصميم أكثر جمالًا من بطاقات الورق التقليدية، وكان تتبع الردود سهلاً للغاية. بالإضافة إلى أنها صديقة للبيئة - خيار مثالي للأزواج العصريين!")
                                    </p>
                                    <div class="wpo-testimonial-text-btm">
                                        <div class="tsm-img">
                                            <img style="height: 75px;width: 95px;" src="~/assets/images/three.png" alt="">
                                        </div>
                                        <h3>@(isEnglish ? "Layla & Amir" : "ليلى وأمير")</h3>
                                        <span>@(isEnglish ? "Engagement - March 2024" : "خطوبة - مارس ٢٠٢٤")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--End wpo-testimonial-section-->