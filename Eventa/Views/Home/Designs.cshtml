@using Microsoft.AspNetCore.Localization
@model Eventa.ApplicationCore.Models.ViewModels.HomeIndexViewModel
@{
    Layout = "~/Views/Shared/_WebsiteLayout.cshtml";
    var isEnglish = Context.Request.Cookies[CookieRequestCultureProvider.DefaultCookieName]?.Split('|')[0]?.Split('=')[1] == "en";
}

<style>
    /* Page-specific styles - Main styles are in modern-home.css */
    .preview-link {
        display: block;
        position: relative;
    }

    .grid .inner {
        position: relative;
        overflow: hidden;
        border-radius: 16px;
    }

    /* Improved Preview Overlay - Light transparent with blur */
    .wpo-demo-grids .preview-overlay {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
    }

    .wpo-demo-grids .preview-overlay span {
        background: rgba(255, 255, 255, 0.95);
        color: #8b5cf6;
        border: none;
        padding: 14px 32px;
        font-weight: 600;
        box-shadow: 0 4px 20px rgba(139, 92, 246, 0.3);
    }

    /* General CTA Button */
    .designs-cta {
        text-align: center;
        padding: 60px 0;
        background: linear-gradient(135deg, #faf5ff 0%, #fdf2f8 100%);
        margin-top: 40px;
    }

    .designs-cta h2 {
        font-size: 2rem;
        color: #1f2937;
        margin-bottom: 15px;
    }

    .designs-cta p {
        color: #6b7280;
        margin-bottom: 25px;
    }

    .cta-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: linear-gradient(135deg, #8b5cf6 0%, #ec4899 100%);
        color: white;
        padding: 15px 35px;
        border-radius: 30px;
        font-weight: 600;
        font-size: 1.1rem;
        text-decoration: none;
        box-shadow: 0 10px 30px rgba(139, 92, 246, 0.4);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .cta-btn-primary:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(139, 92, 246, 0.5);
        color: white;
    }

    .cta-btn-primary i {
        transition: transform 0.3s ease;
    }

    .cta-btn-primary:hover i {
        transform: translateX(-5px);
    }
</style>

<!-- start of demo section -->
<section class="wpo-demo-section section-padding">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col col-lg-6">
                <div class="preview-section-title">
                    <i><img src="~/assets/images/preview/title-1.png" alt=""></i>
                    <h2>@(isEnglish ? "Wedding & Invitation Designs" : "تصاميم الزفاف والدعوات")</h2>
                    <p>
                        @(isEnglish ?
                            "We Happily Prepared 09 Designs for Your Big Day. Pick One of Our Beautiful Designs to Start Your Dreamy Invitation!" :
                            "لقد أعددنا 9 تصاميم جميلة ليومك الكبير. اختر أحد تصاميمنا الرائعة لتبدأ دعوتك الحلم!")
                    </p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col col-xs-12">
                <div class="wpo-demo-grids clearfix">
                    @foreach (var template in Model.Designs)
                    {
                        <div class="grid wow fadeInUp" data-wow-duration="1000ms">
                            <div class="inner">
                                <a href="@template.WebsiteDemoUrl" target="_blank" class="preview-link">
                                    <img src="@template.PreviewImageUrl" alt="@template.Name">
                                    <div class="preview-overlay">
                                        <span>@(isEnglish ? "Preview" : "معاينة")</span>
                                    </div>
                                </a>
                            </div>
                            <h3>@template.Name</h3>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end of demo section -->

<!-- CTA Section -->
<section class="designs-cta">
    <div class="container">
        <h2>@(isEnglish ? "Haven't chosen yet? No worries!" : "لم تختر بعد؟ لا تقلق!")</h2>
        <p>@(isEnglish ? "Start creating your invitation and choose a design along the way" : "ابدأ إنشاء دعوتك واختر التصميم خلال العملية")</p>
        <a href="@Url.Action("CreateNew", "Invitations")" class="cta-btn-primary">
            <i class="fas fa-magic"></i>
            @(isEnglish ? "Start Creating Now" : "ابدأ الإنشاء الآن")
        </a>
    </div>
</section>
