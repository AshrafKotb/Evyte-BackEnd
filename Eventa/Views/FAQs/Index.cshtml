@model FAQIndexVM
@{
    ViewData["Title"] = "الاسئلة الشائعة";
    Layout = "_Layout";
}

<!-- Page Header -->
<div class="page-header animate-fade-in">
    <div class="page-title">
        <h1>
            <i class="fas fa-question-circle"></i>
            الاسئلة الشائعة
        </h1>
        <div class="page-breadcrumb">
            <a href="@Url.Action("Index", "cp")"><i class="fas fa-home"></i></a>
            <i class="fas fa-chevron-left" style="font-size: 0.7rem;"></i>
            <span>الاسئلة الشائعة</span>
        </div>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-gold">
            <i class="fas fa-plus"></i>
            إضافة سؤال جديد
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card animate-slide-in-up" style="margin-bottom: 24px;">
    <div class="card-body" style="padding: 20px;">
        <form asp-action="Index" method="get" class="d-flex gap-3 align-items-end flex-wrap">
            <div class="form-group" style="flex: 1; min-width: 250px; margin-bottom: 0;">
                <label class="form-label">بحث</label>
                <div style="position: relative;">
                    <input type="text" class="form-control" name="searchTerm" value="@Model.SearchTerm"
                           placeholder="ابحث عن سؤال ..." style="padding-right: 40px;">
                    <i class="fas fa-search" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: var(--gray-400);"></i>
                </div>
            </div>
            <div class="form-group" style="min-width: 150px; margin-bottom: 0;">
                <label class="form-label">عدد العناصر</label>
                <select name="pageSize" class="form-control" onchange="this.form.submit()">
                    @foreach (var option in Model.PageSizeOptions)
                    {
                        <option value="@option.Value" selected="@(Model.PageSize.ToString() == option.Value)">
                            @option.Text
                        </option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary" style="height: 48px;">
                <i class="fas fa-search"></i>
                بحث
            </button>
        </form>
    </div>
</div>

<!-- Data Table Card -->
<div class="card animate-slide-in-up">
    <div class="card-header">
        <div class="card-title">
            <i class="fas fa-list"></i>
            <span>قائمة الاسئلة</span>
        </div>
        <div class="card-actions">
            <span class="badge badge-gold" style="padding: 8px 15px; border-radius: 20px;">
                @Model.FAQs.Count() سؤال
            </span>
        </div>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">الترتيب</th>
                        <th>السؤال</th>
                        <th style="width: 150px;">الصفحة الرئيسية</th>
                        <th style="width: 100px;">الحالة</th>
                        <th style="width: 150px;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.FAQs.Any())
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state" style="padding: 60px 20px;">
                                    <i class="fas fa-question-circle" style="font-size: 3rem; color: var(--gray-400); margin-bottom: 15px;"></i>
                                    <h3>لا توجد اسئلة</h3>
                                    <p style="color: var(--gray-400);">لم يتم العثور على أي اسئلة. يمكنك إضافة سؤال جديد.</p>
                                    <a asp-action="Create" class="btn btn-gold" style="margin-top: 15px;">
                                        <i class="fas fa-plus"></i>
                                        إضافة سؤال جديد
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.FAQs)
                        {
                            <tr class="@(item.IsDeleted ? "table-row-deleted" : "")">
                                <td>
                                    <span class="sort-badge">
                                        @item.SortingNumber
                                    </span>
                                </td>
                                <td>
                                    <div class="faq-question-cell">
                                        <div class="question-icon">
                                            <i class="fas fa-comment-dots"></i>
                                        </div>
                                        <div class="question-content">
                                            <strong>@item.QuestionAr</strong>
                                            @if (!string.IsNullOrEmpty(item.QuestionEn))
                                            {
                                                <small>@item.QuestionEn</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (item.HomePage)
                                    {
                                        <span class="badge badge-success">
                                            <i class="fas fa-check"></i> نعم
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-ghost">
                                            <i class="fas fa-minus"></i> لا
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.IsDeleted)
                                    {
                                        <span class="badge badge-danger">
                                            <i class="fas fa-trash"></i> محذوف
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">
                                            <i class="fas fa-check-circle"></i> متاح
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        @if (!item.IsDeleted)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-table-action btn-edit" title="تعديل">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-table-action btn-view" title="التفاصيل">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        }
                                        <button type="button" class="btn-table-action @(item.IsDeleted ? "btn-restore" : "btn-delete") btn-action"
                                                data-id="@item.Id"
                                                data-action="@(item.IsDeleted ? "restore" : "delete")"
                                                title="@(item.IsDeleted ? "استعادة" : "حذف")">
                                            <i class="@(item.IsDeleted ? "fas fa-undo" : "fas fa-trash-alt")"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="table-pagination">
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Model.SearchTerm">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            @if (i == 1 || i == Model.TotalPages || (i >= Model.CurrentPage - 2 && i <= Model.CurrentPage + 2))
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i"
                                       asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Model.SearchTerm">
                                        @i
                                    </a>
                                </li>
                            }
                            else if (i == Model.CurrentPage - 3 || i == Model.CurrentPage + 3)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link page-ellipsis">...</span>
                                </li>
                            }
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Model.SearchTerm">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-action').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.dataset.id;
                const action = this.dataset.action;
                const isDelete = action === 'delete';

                Swal.fire({
                    title: isDelete ? 'حذف السؤال' : 'استعادة السؤال',
                    text: isDelete ? 'هل أنت متأكد من حذف هذا السؤال؟' : 'هل أنت متأكد من استعادة هذا السؤال؟',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: isDelete ? '#f43f5e' : '#10b981',
                    cancelButtonColor: '#6366f1',
                    confirmButtonText: isDelete ? 'نعم، احذف' : 'نعم، استعد',
                    cancelButtonText: 'إلغاء',
                    background: '#1a1a2e',
                    color: '#fff',
                    customClass: {
                        popup: 'swal-modern-popup',
                        title: 'swal-modern-title',
                        confirmButton: 'swal-modern-confirm',
                        cancelButton: 'swal-modern-cancel'
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = isDelete ? '@Url.Action("Delete", "FAQs")' : '@Url.Action("Restore", "FAQs")';

                        const tokenInput = document.createElement('input');
                        tokenInput.type = 'hidden';
                        tokenInput.name = '__RequestVerificationToken';
                        tokenInput.value = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];
                        form.appendChild(tokenInput);

                        const idInput = document.createElement('input');
                        idInput.type = 'hidden';
                        idInput.name = 'id';
                        idInput.value = id;
                        form.appendChild(idInput);

                        document.body.appendChild(form);
                        form.submit();
                    }
                });
            });
        });
    </script>
}
